[:project
 {:projections
  [{p_brand p.2/p_brand}
   {p_type p.2/p_type}
   {p_size p.2/p_size}
   {supplier_cnt supplier_cnt}]}
 [:sort
  {:order-specs
   [[supplier_cnt {:direction :desc, :null-ordering :nulls-first}]
    [p.2/p_brand {:direction :asc, :null-ordering :nulls-last}]
    [p.2/p_type {:direction :asc, :null-ordering :nulls-last}]
    [p.2/p_size {:direction :asc, :null-ordering :nulls-last}]]}
  [:map
   {:projections [{supplier_cnt _count_distinct_out_5}]}
   [:group-by
    {:columns
     [p.2/p_brand
      p.2/p_type
      p.2/p_size
      {_count_distinct_out_5 (count_distinct ps.1/ps_suppkey)}]}
    [:map
     {:projections [{_sq_3 true}]}
     [:mega-join
      {:conditions [{ps.1/ps_partkey p.2/_id}]}
      [[:anti-join
        {:conditions [{ps.1/ps_suppkey _id}]}
        [:rename
         {:prefix ps.1}
         [:scan
          {:db-name "xtdb",
           :table #xt/table partsupp,
           :columns [ps_partkey ps_suppkey]}]]
        [:project
         {:projections [{_id s.4/_id}]}
         [:rename
          {:prefix s.4}
          [:scan
           {:db-name "xtdb",
            :table #xt/table supplier,
            :columns
            [{s_comment (like s_comment "%Customer%Complaints%")}
             _id]}]]]]
       [:rename
        {:prefix p.2}
        [:scan
         {:db-name "xtdb",
          :table #xt/table part,
          :columns
          [_id
           {p_brand (<> p_brand "Brand#45")}
           {p_size
            (or
             (== p_size 49)
             (== p_size 14)
             (== p_size 23)
             (== p_size 45)
             (== p_size 19)
             (== p_size 3)
             (== p_size 36)
             (== p_size 9))}
           {p_type (not (like p_type "MEDIUM POLISHED%"))}]}]]]]]]]]]
