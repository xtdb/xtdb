[:project
 {:projections [{revenue _sum_out_3}]}
 [:group-by
  {:columns [{_sum_out_3 (sum _sum_in_4)}]}
  [:map
   {:projections
    [{_sum_in_4 (* l.1/l_extendedprice (- 1 l.1/l_discount))}]}
   [:mega-join
    {:conditions
     [{l.1/l_partkey p.2/_id}
      (or
       (or
        (and
         (and
          (and
           (and
            (and
             (and
              (== p.2/p_brand "Brand#12")
              (or
               (== p.2/p_container "SM CASE")
               (== p.2/p_container "SM BOX")
               (== p.2/p_container "SM PACK")
               (== p.2/p_container "SM PKG")))
             (>= l.1/l_quantity 1))
            (<= l.1/l_quantity (+ 1 10)))
           (between p.2/p_size 1 5))
          (or (== l.1/l_shipmode "AIR") (== l.1/l_shipmode "AIR REG")))
         (== l.1/l_shipinstruct "DELIVER IN PERSON"))
        (and
         (and
          (and
           (and
            (and
             (and
              (== p.2/p_brand "Brand#23")
              (or
               (== p.2/p_container "MED BAG")
               (== p.2/p_container "MED BOX")
               (== p.2/p_container "MED PKG")
               (== p.2/p_container "MED PACK")))
             (>= l.1/l_quantity 10))
            (<= l.1/l_quantity (+ 10 10)))
           (between p.2/p_size 1 10))
          (or (== l.1/l_shipmode "AIR") (== l.1/l_shipmode "AIR REG")))
         (== l.1/l_shipinstruct "DELIVER IN PERSON")))
       (and
        (and
         (and
          (and
           (and
            (and
             (== p.2/p_brand "Brand#34")
             (or
              (== p.2/p_container "LG CASE")
              (== p.2/p_container "LG BOX")
              (== p.2/p_container "LG PACK")
              (== p.2/p_container "LG PKG")))
            (>= l.1/l_quantity 20))
           (<= l.1/l_quantity (+ 20 10)))
          (between p.2/p_size 1 15))
         (or (== l.1/l_shipmode "AIR") (== l.1/l_shipmode "AIR REG")))
        (== l.1/l_shipinstruct "DELIVER IN PERSON")))]}
    [[:rename
      {:prefix l.1}
      [:scan
       {:db-name "xtdb",
        :table #xt/table lineitem,
        :columns
        [l_extendedprice
         l_quantity
         l_shipinstruct
         l_shipmode
         l_discount
         l_partkey]}]]
     [:rename
      {:prefix p.2}
      [:scan
       {:db-name "xtdb",
        :table #xt/table part,
        :columns [_id p_brand p_size p_container]}]]]]]]]
