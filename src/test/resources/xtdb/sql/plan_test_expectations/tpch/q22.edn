[:project
 {:projections
  [{cntrycode custsale.8/cntrycode}
   {numcust numcust}
   {totacctbal totacctbal}]}
 [:sort
  {:order-specs
   [[custsale.8/cntrycode
     {:direction :asc, :null-ordering :nulls-last}]]}
  [:map
   {:projections [{numcust _row_count_9} {totacctbal _sum_out_10}]}
   [:group-by
    {:columns
     [custsale.8/cntrycode
      {_sum_out_10 (sum custsale.8/c_acctbal)}
      {_row_count_9 (row-count)}]}
    [:rename
     {:prefix custsale.8}
     [:project
      {:projections
       [{cntrycode (substring c.1/c_phone 1 2)}
        {c_acctbal c.1/c_acctbal}]}
      [:map
       {:projections [{_sq_5 true}]}
       [:anti-join
        {:conditions [{c.1/_id o_custkey}]}
        [:select
         {:predicate (> c.1/c_acctbal _sq_2)}
         [:single-join
          {:conditions []}
          [:rename
           {:prefix c.1}
           [:scan
            {:db-name "xtdb",
             :table #xt/table customer,
             :columns
             [{c_phone
               (or
                (== (substring c_phone 1 2) "13")
                (== (substring c_phone 1 2) "31")
                (== (substring c_phone 1 2) "23")
                (== (substring c_phone 1 2) "29")
                (== (substring c_phone 1 2) "30")
                (== (substring c_phone 1 2) "18")
                (== (substring c_phone 1 2) "17"))}
              c_acctbal
              _id]}]]
          [:project
           {:projections [{_sq_2 _avg_out_4}]}
           [:group-by
            {:columns [{_avg_out_4 (avg c.3/c_acctbal)}]}
            [:rename
             {:prefix c.3}
             [:scan
              {:db-name "xtdb",
               :table #xt/table customer,
               :columns
               [{c_phone
                 (or
                  (== (substring c_phone 1 2) "13")
                  (== (substring c_phone 1 2) "31")
                  (== (substring c_phone 1 2) "23")
                  (== (substring c_phone 1 2) "29")
                  (== (substring c_phone 1 2) "30")
                  (== (substring c_phone 1 2) "18")
                  (== (substring c_phone 1 2) "17"))}
                {c_acctbal (> c_acctbal 0.0)}]}]]]]]]
        [:project
         {:projections
          [{_id o.6/_id}
           {o_clerk o.6/o_clerk}
           {o_comment o.6/o_comment}
           {o_custkey o.6/o_custkey}
           {o_orderdate o.6/o_orderdate}
           {o_orderpriority o.6/o_orderpriority}
           {o_orderstatus o.6/o_orderstatus}
           {o_shippriority o.6/o_shippriority}
           {o_totalprice o.6/o_totalprice}]}
         [:rename
          {:prefix o.6}
          [:scan
           {:db-name "xtdb",
            :table #xt/table orders,
            :columns
            [o_orderpriority
             o_clerk
             o_orderstatus
             o_totalprice
             _id
             o_orderdate
             o_comment
             o_shippriority
             o_custkey]}]]]]]]]]]]]
