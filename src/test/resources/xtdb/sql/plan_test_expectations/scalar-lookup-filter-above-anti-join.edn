[:project
 {:projections [{_id c.1/_id}]}
 [:select
  {:predicate (> c.1/bal _sq_5)}
  [:single-join
   {:conditions []}
   [:map
    {:projections [{_sq_2 true}]}
    [:anti-join
     {:conditions [{c.1/_id o.3/custkey}]}
     [:rename
      {:prefix c.1}
      [:scan
       {:db-name "xtdb",
        :table #xt/table customer,
        :columns
        [_id
         {phone
          (or
           (== (substring phone 1 2) "13")
           (== (substring phone 1 2) "31"))}
         bal]}]]
     [:rename
      {:prefix o.3}
      [:scan
       {:db-name "xtdb",
        :table #xt/table orders,
        :columns [custkey]}]]]]
   [:project
    {:projections [{_sq_5 c2.6/bal}]}
    [:rename
     {:prefix c2.6}
     [:scan
      {:db-name "xtdb",
       :table #xt/table customer,
       :columns [{_id (== _id 1)} bal]}]]]]]]
