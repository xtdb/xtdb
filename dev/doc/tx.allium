-- allium: 3
-- tx.allium
--
-- The connection-level transaction model of XTDB: the client-facing transaction
-- lifecycle that sits ABOVE db.allium. Where db.allium begins at submitTx/executeTx
-- (the Database boundary), this spec covers everything a client does before that —
-- begin / buffer / commit, access-mode resolution, and the read basis a transaction's
-- reads observe.
--
-- Scope: one client connection's transaction lifecycle.
-- Entity/field names match the Kotlin in core/src/main/kotlin/xtdb/api/Xtdb.kt
-- (Connection, Transaction, Phase Pending/Reading/Writing, Characteristics, DmlBuffer) and the SQL
-- classifier in core/src/main/kotlin/xtdb/query/SqlParser.kt → ParsedStatement.
--
-- == Frontend parity (the point of this spec) ==
--
-- Both protocol frontends — pgwire and ADBC / Flight SQL — reach this ENTIRE model
-- through one shared Connection. There are two ways a client drives a transaction:
--
--   1. tx-control-as-SQL: BEGIN [modes], SET TRANSACTION modes, COMMIT [SYNC | ASYNC] and ROLLBACK, sent as SQL, classified by the SqlParser (Begin / SetTransaction / Commit / Rollback) and handled by the connection.
--      This is the FULL surface — access mode, read basis, commit-opts and the transaction's time zone are all expressible here.
--      An ADBC / Flight SQL client expresses the whole model this way.
--   2. programmatic basic-control: setAutoCommit / commit / rollback on the ADBC
--      AdbcConnection surface. Retained for driver ergonomics; a strict subset of (1).
--
-- This is the TARGET contract for an in-progress arc. The work in progress brings ADBC
-- up to this contract (tx-control-as-SQL + retained programmatic control); once ADBC
-- reaches it, pgwire is migrated onto the same Connection model wholesale. Code will
-- catch up increment by increment — this describes the intended complete model, not
-- only what is implemented today.
--
-- == Boundaries ==
--
-- Below: db.allium's submitTx / executeTx. A Writing commit drains the buffer and
--        crosses this boundary (submit when async, execute-and-await when sync). The
--        async/sync choice is the commit's own COMMIT SYNC / COMMIT ASYNC if it states one,
--        else the transaction's begin-time async flag.
-- Above: the Frontend (pgwire / ADBC client) that decodes the wire protocol and feeds
--        SQL strings and programmatic calls into the Connection.

---- Given

given {
    connection: Connection
}

---- External Entities

external entity Frontend {
    -- The protocol frontend driving the connection: pgwire, or an ADBC / Flight SQL
    -- client. It decodes the wire protocol and feeds SQL strings (and, for ADBC, the
    -- programmatic setAutoCommit/commit/rollback calls) into the Connection. The
    -- connection model is frontend-agnostic; this is the party on the far side.
}

external entity Database {
    -- The db.allium submit/execute boundary. submitTx is fire-and-forget; executeTx
    -- submits then awaits the result. A Writing commit drains the buffer across this
    -- boundary — submitting when async, executing-and-awaiting when sync, where the choice is
    -- the commit's own COMMIT SYNC / COMMIT ASYNC if stated, else the tx's begin-time async
    -- flag. See: dev/doc/db.allium, database/Database.kt
}

external entity SqlParser {
    -- The SQL classifier (xtdb.query.SqlParser → ParsedStatement). Recognises
    -- tx-control statements (Begin / Commit / Rollback) and statement kinds
    -- (Query vs Dml) without planning. The shared path by which a client expresses
    -- the full transaction model as SQL. See: core/src/main/kotlin/xtdb/query/SqlParser.kt
}

external entity SqlPlanner {
    -- The connection's expression evaluator (xtdb.query.SqlPlanner). Sibling of the
    -- SqlParser: where the parser CLASSIFIES a statement, the planner EVALUATES a
    -- standalone transaction-option expression to its runtime value — it plans the
    -- expression and substitutes positional params, turning e.g. SYSTEM_TIME's
    -- `TIMESTAMP '…'` into a concrete instant. Injected (an SPI), shared with pgwire.
    -- See: core/src/main/kotlin/xtdb/query/SqlPlanner.kt
}

external entity User {
    -- The session identity, established once at authentication. Stamped onto every
    -- transaction this connection submits. Not a per-transaction option.
}

---- Value Types

-- Host-platform types carried opaquely at this level. (Instants map to the Allium
-- primitive Timestamp; ZoneId and Bytes have no primitive equivalent, so they are
-- structureless value types — opaque by-value carriers.)
value ZoneId {
    -- java.time.ZoneId — a connection / transaction timezone.
}

value Bytes {
    -- Opaque serialized bytes (e.g. per-transaction user metadata).
}

value TxBasisToken {
    -- An opaque await-token: the read basis carried between connection and Database so
    -- a connection's reads observe (at least) its own prior writes. Each write advances
    -- it; each read threads it through. See: database/encodeTxBasisToken.
}

value TimeBasisToken {
    -- An opaque snapshot token: per-database latest-completed system-times, the upper bound
    -- on the data a read observes. Captured from the Database catalog at a transaction's
    -- first query to pin its snapshot. See: database/encodeTimeBasisToken, Database.Catalog.snapshotToken.
}

value ReadBasis {
    -- The pinned point-in-time a transaction's reads observe, fixed at the transaction's
    -- first query (snapshot isolation from that query on). The pin awaits the effective
    -- await_token (so the snapshot reflects this connection's own writes), then sets
    -- snapshot_token to the resulting latest-completed snapshot and clock_time to the
    -- current-time at the pin; the ReadOnly characteristics declared at BEGIN override
    -- individual fields.
    -- The options are grammar-scoped to READ ONLY (readOnlyTxOption in the SQL grammar).
    --   snapshot_token — the data snapshot's upper bound, a TimeBasisToken (per-database
    --                    latest-completed system-times). Distinct from the await_token, which
    --                    is a TxBasisToken of message-ids the read awaits before snapshotting.
    --   snapshot_time  — observe state as of a wall-clock instant.
    --   clock_time     — pin the transaction's notion of "now".
    snapshot_token: TimeBasisToken?
    snapshot_time: Timestamp?
    clock_time: Timestamp?
}

value Unspecified {
    -- Characteristics of a BEGIN that declared no access mode. Carries nothing.
}

value ReadOnly {
    -- Characteristics declared by BEGIN or SET TRANSACTION READ ONLY, evaluated then and held until the first query pins the read basis.
    -- Each absent option takes its default at the pin.
    --   snapshot_token / snapshot_time / clock_time — override the corresponding ReadBasis field.
    --   await_token — overrides the connection's await_token for this transaction's pin.
    --                 Validated (decoded) when declared; the await itself happens at the pin.
    snapshot_token: TimeBasisToken?
    snapshot_time: Timestamp?
    clock_time: Timestamp?
    await_token: TxBasisToken?
}

value CommitOpts {
    -- Write-side options, grammar-scoped to READ WRITE (readWriteTxOption in the SQL
    -- grammar). Their very presence implies the transaction is Writing.
    -- The transaction's effective timezone is NOT a commit-opt: it is set by BEGIN or SET TRANSACTION as the tx's tx_default_tz (see Transaction), not deferred to COMMIT.
    --   system_time   — the system-time to record the transaction at.
    --   user_metadata — opaque per-transaction metadata.
    --   async         — true: commit submits without awaiting; false: execute-and-await.
    --                    The begin-time default; a COMMIT SYNC / COMMIT ASYNC (see CommitMode)
    --                    overrides it for that one commit.
    system_time: Timestamp?
    user_metadata: Bytes?
    async: Boolean
}

value OptionSetting {
    -- One option as a SET TRANSACTION or BEGIN names it: the value its expression evaluates to, or null for DEFAULT, which clears the option.
    -- An option the statement doesn't name has no OptionSetting at all.
    value: Any?
}

value ReadOnlySettings {
    -- The read-only options a READ ONLY statement names; each one it doesn't name is null.
    snapshot_token: OptionSetting?
    snapshot_time: OptionSetting?
    clock_time: OptionSetting?
    await_token: OptionSetting?
}

value ReadWriteSettings {
    -- The read-write options a READ WRITE statement names; each one it doesn't name is null.
    system_time: OptionSetting?
    user_metadata: OptionSetting?
    async: OptionSetting?
}

value TxOp {
    -- A single buffered operation (a SQL DML statement plus its column-major args, or a
    -- doc put). Opaque at this level. See: tx/TxOp.kt
}

---- Enumerations

enum StatementKind {
    -- How the SqlParser classifies an executable statement for access-mode resolution.
    -- A query pins a pending tx's read basis, making it Reading; a DML statement makes
    -- a Pending(Unspecified) tx Writing. (DDL that submits as tx-ops — CREATE TABLE, GRANT — classifies as dml.)
    query | dml
}

enum BeginAccessMode {
    -- The access mode carried explicitly on a BEGIN or SET TRANSACTION. `read_only` /
    -- `read_write` fix the mode; `none` states no access mode (an isolation level or a time zone only), which leaves the mode as it was.
    -- This is distinct from inferring the mode from non-null read options or commit-opts: it lets `READ ONLY` with no options still make the transaction Pending(ReadOnly).
    read_only | read_write | none
}

enum SessionAccessMode {
    -- The connection's session-level default access mode, set by SET SESSION CHARACTERISTICS
    -- AS TRANSACTION READ ONLY / READ WRITE. When set, a bare BEGIN (access_mode = none) takes
    -- this default; absent (null), a bare BEGIN opens Pending(Unspecified).
    read_only | read_write
}

enum CommitMode {
    -- A commit-time submit-vs-execute override carried on a SQL COMMIT [SYNC | ASYNC].
    -- `sync` forces execute-and-await, `async` forces fire-and-forget submit. Passed as an
    -- optional CommitTransaction parameter (null = no commit-time override, defer to the
    -- transaction's begin-time CommitOpts.async flag). Distinct from that begin-time flag: it
    -- lets a single COMMIT override the mode fixed at BEGIN READ WRITE WITH (ASYNC = ...).
    sync | async
}

---- Entities and Variants

entity Connection {
    -- A session-scoped handle onto the node, shared by both protocol frontends.
    -- See: core/src/main/kotlin/xtdb/api/Xtdb.kt (Xtdb.Connection)
    user: User                       -- session identity, set once at authentication
    auto_commit: Boolean
    default_tz: ZoneId
    await_token: TxBasisToken?       -- advanced by every write, threaded through every read
    default_access_mode: SessionAccessMode?  -- set by SET SESSION CHARACTERISTICS; null leaves a bare BEGIN unspecified

    -- At most one open transaction. Singular relationship: the value is the open
    -- Transaction, or null when none is open.
    tx: Transaction with connection = this

    invariant AtMostOneOpenTransaction {
        -- Enforced structurally by the singular relationship: a connection has at most
        -- one open Transaction at a time. BEGIN while tx != null is an error
        -- (see BeginWhileOpenRejected).
        true
    }
}

entity Transaction {
    -- One open transaction on a connection. It is in one of three phases: Pending (BEGIN's
    -- characteristics declared, nothing pinned), Reading (read basis pinned) or Writing
    -- (buffering DML). `failed` records an abort: once set, the
    -- transaction rejects all further statements until rolled back.
    -- See: Xtdb.Connection.Transaction
    connection: Connection
    mode: Pending | Reading | Writing
    failed: Boolean
    tx_default_tz: ZoneId            -- the tz this tx's DML and reads anchor in (the TIMEZONE BEGIN or SET TRANSACTION set, else the connection default at BEGIN)
    session_default_tz: ZoneId       -- the connection default_tz to write back to the connection on COMMIT
}

variant Pending : Transaction {
    -- Opened by BEGIN with no access mode (Unspecified) or BEGIN READ ONLY (ReadOnly). No read
    -- basis is pinned yet. The first query pins it, making the tx Reading; DML makes an
    -- Unspecified tx Writing and is rejected in a ReadOnly one (see FirstQueryPinsReadBasis /
    -- FirstStatementResolvesWriting / DmlInReadOnlyRejected).
    characteristics: Unspecified | ReadOnly
}

variant Reading : Transaction {
    -- A read-only transaction. Carries the read basis its reads observe, and the await_token
    -- override its pin used, if any. XTDB read-only transactions are READ-only in the strict
    -- sense: DML is rejected (see DmlInReadOnlyRejected).
    read_basis: ReadBasis
    await_token: TxBasisToken?
}

variant Writing : Transaction {
    -- A write-only transaction. Buffers DML; queries are rejected (see QueryInWritingRejected).
    -- Carries the commit-opts that govern how the buffer is submitted at COMMIT.
    buffer: DmlBuffer with transaction = this
    commit_opts: CommitOpts
}

entity DmlBuffer {
    -- Accumulates buffered ops for a Writing transaction. Consecutive same-SQL ops
    -- coalesce: their args are appended column-major into the last op, so a prepared
    -- INSERT executed in a loop becomes one multi-row op. Drained at COMMIT.
    -- See: Xtdb.Connection.DmlBuffer
    transaction: Transaction
    ops: List<TxOp>
}

---- Rules: Beginning a Transaction

-- An explicit SQL BEGIN opens a transaction regardless of auto_commit; the flag is left
-- untouched and the explicit transaction coexists with it.
--
-- BEGIN / START TRANSACTION take the same list of modes as SET TRANSACTION.
-- BEGIN also takes `READ ONLY WITH (...)` / `READ WRITE WITH (...)`, whose WITH list holds that access mode's options and TIMEZONE.
-- Either way, BEGIN opens a transaction with the session default access mode, then applies SET TRANSACTION with BEGIN's characteristics (see Rules: Setting Transaction Characteristics).
-- If applying them is rejected, the transaction is rolled back, so a failed BEGIN leaves none open.
--
-- No BEGIN pins a read basis: that happens at the transaction's first query. The phase a
-- BEGIN opens depends on the session default access mode:
--   READ ONLY default  → Pending(ReadOnly with no options)
--   READ WRITE default → Writing, empty buffer (no basis — writes don't read)
--   no default         → Pending(Unspecified), resolved by the first statement

rule BeginOpensTransaction {
    -- begin(): opens the transaction in the phase the session default access mode gives.
    -- A connection with default_access_mode set (via SET SESSION CHARACTERISTICS) opens
    -- Pending(ReadOnly with no options) / Writing directly; with no default set it opens
    -- Pending(Unspecified), resolved by the first statement (the common case).
    -- tx_default_tz and session_default_tz are the connection's default_tz.
    -- BEGIN's own characteristics, if any, are then applied by SET TRANSACTION.
    when: BeginTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx = null

    ensures:
        if connection.default_access_mode = read_only:
            Pending.created(
                connection: connection,
                failed: false,
                tx_default_tz: connection.default_tz,
                session_default_tz: connection.default_tz,
                characteristics: ReadOnly(
                    snapshot_token: null,
                    snapshot_time: null,
                    clock_time: null,
                    await_token: null
                )
            )
        else if connection.default_access_mode = read_write:
            let buffer = DmlBuffer.created(ops: {})
            Writing.created(
                connection: connection,
                failed: false,
                tx_default_tz: connection.default_tz,
                session_default_tz: connection.default_tz,
                buffer: buffer,
                commit_opts: CommitOpts(
                    system_time: null,
                    user_metadata: null,
                    async: false
                )
            )
        else:
            Pending.created(
                connection: connection,
                failed: false,
                tx_default_tz: connection.default_tz,
                session_default_tz: connection.default_tz,
                characteristics: Unspecified
            )
        SetTransaction(
            frontend: frontend,
            connection: connection,
            access_mode: access_mode,
            read_only_opts: read_only_opts,
            commit_opts: commit_opts,
            tz_override: tz_override
        )
}

rule BeginRollsBackOnRejectedCharacteristics {
    -- BEGIN's SET TRANSACTION was rejected (for instance, a malformed AWAIT_TOKEN): the
    -- transaction BEGIN opened is rolled back, so a failed BEGIN leaves no transaction open.
    when: BeginCharacteristicsRejected(frontend, connection, error_code)
    requires: connection.tx != null

    ensures:
        not exists connection.tx
        BeginRejected(error_code: error_code)
}

rule BeginWhileOpenRejected {
    -- At most one open transaction per connection: BEGIN while one is open is an error.
    when: BeginTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx != null

    ensures:
        BeginRejected(error_code: `xtdb/tx-already-open`)
}

---- Rules: Setting Transaction Characteristics

-- SET TRANSACTION takes a comma-separated list of transaction modes, the access mode anywhere in it:
--   READ ONLY | READ WRITE — the access mode
--   SNAPSHOT_TOKEN | SNAPSHOT_TIME | CLOCK_TIME | AWAIT_TOKEN = ... — read-only options
--   SYSTEM_TIME | METADATA | ASYNC = ... — read-write options
--   TIMEZONE = ... — the transaction's time zone
--   ISOLATION LEVEL ... — accepted, with no effect: XTDB is always serializable
-- A read-only or read-write option needs its access mode in the same statement, or the statement doesn't parse; TIMEZONE and ISOLATION LEVEL need none.
-- The event carries the access mode (see BeginAccessMode), the options of that mode the statement names (read_only_opts as ReadOnlySettings, commit_opts as ReadWriteSettings), and the time zone if it names one (tz_override, an OptionSetting).
-- Each option's value is an expression, evaluated through the SqlPlanner with the statement's bound args, or DEFAULT, which clears it.
-- Instants without a zone are read in the transaction's time zone as this same statement resolves it.
--
-- A SET TRANSACTION merges into the characteristics set before it.
-- Within the access mode the transaction already has, it sets only the options it names and keeps the rest; switching access mode drops the other mode's options.
-- The time zone belongs to the transaction, not to its access mode: it is kept across a switch of access mode and across a SET TRANSACTION that doesn't name it, and TIMEZONE = DEFAULT resets it to session_default_tz.
-- It sets the tx's tx_default_tz only, so it reverts at COMMIT and ROLLBACK as BEGIN's does.
--
-- A SET TRANSACTION naming an access mode or a time zone is accepted while the transaction is Pending, or Writing with an empty buffer.
-- Once a query has pinned the read basis (Reading), or a Writing tx has buffered ops, it is rejected.
-- One naming neither is accepted in any state and changes nothing.
--
-- Xtdb.Connection.setTransactionReadOnly / setTransactionReadWrite / setTransactionTimeZone are the same operation without SQL.
-- Each argument sets its option, null meaning not given, so they cannot clear one.

rule SetTransactionReadOnly {
    -- READ ONLY makes the phase Pending(ReadOnly), with the options evaluated now and held until the first query pins the basis they override (see FirstQueryPinsReadBasis).
    -- A Pending(ReadOnly) tx keeps the options this statement doesn't name; any other phase starts with none.
    -- A malformed AWAIT_TOKEN is rejected here; the await itself happens at the pin.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx != null
    requires: connection.tx.mode = Pending or (connection.tx.mode = Writing and connection.tx.buffer.ops.count = 0)
    requires: access_mode = read_only

    ensures:
        let prior =
            if connection.tx.mode = Pending and connection.tx.characteristics = ReadOnly: connection.tx.characteristics
            else: null
        connection.tx.mode = Pending
        connection.tx.characteristics = ReadOnly(
            snapshot_token:
                if read_only_opts?.snapshot_token != null: read_only_opts.snapshot_token.value
                else: prior?.snapshot_token,
            snapshot_time:
                if read_only_opts?.snapshot_time != null: read_only_opts.snapshot_time.value
                else: prior?.snapshot_time,
            clock_time:
                if read_only_opts?.clock_time != null: read_only_opts.clock_time.value
                else: prior?.clock_time,
            await_token:
                if read_only_opts?.await_token != null: read_only_opts.await_token.value
                else: prior?.await_token
        )
        connection.tx.tx_default_tz =
            if tz_override != null: tz_override.value ?? connection.tx.session_default_tz
            else: connection.tx.tx_default_tz
}

rule SetTransactionReadWrite {
    -- READ WRITE makes the phase Writing with an empty buffer: a Writing tx carries no read basis, as writes don't read.
    -- A Writing tx keeps the commit-opts this statement doesn't name; any other phase starts with the defaults (no system-time, no metadata, synchronous).
    -- ASYNC = DEFAULT makes the commit synchronous.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx != null
    requires: connection.tx.mode = Pending or (connection.tx.mode = Writing and connection.tx.buffer.ops.count = 0)
    requires: access_mode = read_write

    ensures:
        let prior =
            if connection.tx.mode = Writing: connection.tx.commit_opts
            else: null
        let buffer = DmlBuffer.created(ops: {})
        connection.tx.mode = Writing
        connection.tx.buffer = buffer
        connection.tx.commit_opts = CommitOpts(
            system_time:
                if commit_opts?.system_time != null: commit_opts.system_time.value
                else: prior?.system_time,
            user_metadata:
                if commit_opts?.user_metadata != null: commit_opts.user_metadata.value
                else: prior?.user_metadata,
            async:
                if commit_opts?.async != null: commit_opts.async.value ?? false
                else: prior?.async ?? false
        )
        connection.tx.tx_default_tz =
            if tz_override != null: tz_override.value ?? connection.tx.session_default_tz
            else: connection.tx.tx_default_tz
}

rule SetTransactionTimeZoneOnly {
    -- A SET TRANSACTION naming a time zone but no access mode sets the tx's tx_default_tz and leaves the phase and its options as they are.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx != null
    requires: connection.tx.mode = Pending or (connection.tx.mode = Writing and connection.tx.buffer.ops.count = 0)
    requires: access_mode = none
    requires: tz_override != null

    ensures:
        connection.tx.tx_default_tz = tz_override.value ?? connection.tx.session_default_tz
}

rule SetTransactionAfterFirstStatementRejected {
    -- A Reading tx has pinned its basis, and a Writing tx with buffered ops has captured
    -- its statements under the current characteristics: neither can be reshaped.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx != null
    requires: access_mode != none or tz_override != null
    requires: connection.tx.mode = Reading or (connection.tx.mode = Writing and connection.tx.buffer.ops.count > 0)

    ensures:
        StatementRejected(error_code: `xtdb/set-transaction-after-first-statement`)
}

rule SetTransactionOutsideTxRejected {
    -- Under auto-commit there is no transaction to set characteristics on.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx = null
    requires: access_mode != none or tz_override != null
    requires: connection.auto_commit

    ensures:
        StatementRejected(error_code: `xtdb/set-transaction-outside-tx`)
}

rule SetTransactionOpensTransaction {
    -- Under manual commit with no transaction open, SET TRANSACTION opens a Pending(Unspecified)
    -- transaction first, then applies its characteristics by the rules above.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: connection.tx = null
    requires: access_mode != none or tz_override != null
    requires: not connection.auto_commit

    ensures:
        Pending.created(
            connection: connection,
            failed: false,
            tx_default_tz: connection.default_tz,
            session_default_tz: connection.default_tz,
            characteristics: Unspecified
        )
        SetTransaction(
            frontend: frontend,
            connection: connection,
            access_mode: access_mode,
            read_only_opts: read_only_opts,
            commit_opts: commit_opts,
            tz_override: tz_override
        )
}

rule SetTransactionIsolationOnly {
    -- A SET TRANSACTION naming neither an access mode nor a time zone (an isolation level only) is accepted in any state and changes nothing: XTDB is always serializable.
    when: SetTransaction(frontend, connection, access_mode, read_only_opts, commit_opts, tz_override)
    requires: access_mode = none
    requires: tz_override = null

    ensures:
        SetTransactionAccepted(connection: connection)
}

---- Rules: Access-Mode Resolution

-- When BEGIN did not fix the access mode, the first statement resolves it. A query pins the
-- read basis of a Pending transaction, making it Reading; a DML statement makes a
-- Pending(Unspecified) transaction Writing. A Pending(ReadOnly) transaction accepts only
-- queries; a Reading or Writing transaction stays as it is and enforces its direction (see the
-- write-only rules below).

rule FirstQueryPinsReadBasis {
    -- First query in a Pending tx pins the read basis and opens Reading. The pin awaits the
    -- effective await_token — the ReadOnly characteristics' override, else the connection's —
    -- then captures the latest-completed snapshot and the current-time; any option set in the
    -- ReadOnly characteristics overrides its default.
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: connection.tx != null
    requires: connection.tx.mode = Pending
    requires: kind = query

    ensures:
        let opts = connection.tx.characteristics
        connection.tx.mode = Reading
        connection.tx.read_basis = ReadBasis(
            snapshot_token: opts?.snapshot_token ?? Database.snapshotToken,
            snapshot_time: opts?.snapshot_time,
            clock_time: opts?.clock_time ?? now
        )
        connection.tx.await_token = opts?.await_token
}

rule FirstStatementResolvesWriting {
    -- First statement in a Pending(Unspecified) tx is DML → Writing with an empty buffer and
    -- default commit-opts (synchronous, no system-time override); no read basis was pinned.
    -- The DML op itself is then buffered by BufferDml.
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: connection.tx != null
    requires: connection.tx.mode = Pending
    requires: connection.tx.characteristics = Unspecified
    requires: kind = dml

    ensures:
        let buffer = DmlBuffer.created(ops: {})
        connection.tx.mode = Writing
        connection.tx.buffer = buffer
        connection.tx.commit_opts = CommitOpts(
            system_time: null,
            user_metadata: null,
            async: false
        )
}

---- Rules: Timezone

-- SET TIME ZONE is a session operator. This spec touches it only for its transaction
-- scoping — the broader SET / SHOW session surface is out of frame (as with SET SESSION
-- CHARACTERISTICS, referenced only as a source of default_access_mode).
-- A TIMEZONE on BEGIN or SET TRANSACTION stays tx-scoped (it sets tx_default_tz, never session_default_tz); a mid-tx SET TIME ZONE writes both, so it persists on COMMIT and reverts on ROLLBACK.

rule SetTimeZoneInTx {
    -- Mid-transaction SET TIME ZONE writes BOTH the tx's tx_default_tz (so this tx's DML and
    -- reads re-anchor) AND its session_default_tz (so the change is written back to the
    -- connection on COMMIT and persists past the tx). The connection's own default_tz is left
    -- untouched while the tx is open — that is what makes the ROLLBACK revert implicit.
    when: SetTimeZone(frontend, connection, zone)
    requires: connection.tx != null
    requires: not (connection.tx.mode = Writing and connection.tx.buffer.ops.count > 0)

    ensures:
        connection.tx.tx_default_tz = zone
        connection.tx.session_default_tz = zone
}

rule SetTimeZoneInWriteTxRejected {
    -- SET TIME ZONE is rejected once a Writing tx has buffered ops: those ops captured
    -- temporal literals under the old zone, so changing it mid-buffer would be inconsistent.
    when: SetTimeZone(frontend, connection, zone)
    requires: connection.tx != null
    requires: connection.tx.mode = Writing
    requires: connection.tx.buffer.ops.count > 0

    ensures:
        StatementRejected(error_code: `xtdb/set-tz-in-write-tx`)
}

rule SetTimeZoneNoTx {
    -- With no open transaction, SET TIME ZONE updates the connection's default_tz directly.
    when: SetTimeZone(frontend, connection, zone)
    requires: connection.tx = null

    ensures:
        connection.default_tz = zone
}

---- Rules: Statement Execution

-- A DML statement auto-executes as its own single-op transaction IFF no explicit
-- transaction is open. Otherwise it buffers into the open transaction — even when
-- auto_commit is on. (An explicit BEGIN coexists with auto_commit; the open tx wins.)
--
-- The auto_commit guards across these rules partition the no-explicit-BEGIN cases cleanly:
--   {auto_commit + no tx}  → AutoCommitDml / AutoCommitQuery (transient per-statement tx)
--   {not auto_commit + no tx} → ManualLazyOpenDml / ManualLazyOpenQuery (lazy-open, below)
--   {tx open}              → BufferDml / QueryInReading / the rejection rules

rule AutoCommitDml {
    -- No explicit transaction open: the DML statement is its own transaction. It submits
    -- through the Database boundary as a single-op execute-and-await. auto_commit must be
    -- on (an explicit BEGIN would have opened a tx, taking the BufferDml path instead).
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = dml
    requires: connection.tx = null
    requires: connection.auto_commit

    ensures:
        Database.executeTx(
            ops: { statement },
            opts: { user: connection.user, default_tz: connection.default_tz }
        )
        AwaitTokenAdvanced(connection: connection)

    @guidance
        -- A single-statement auto-commit DML carries no buffering; it is the degenerate
        -- case of "open, buffer one op, commit synchronously". executeTx advances the
        -- connection's await_token so subsequent reads on this connection see the write.
}

rule ManualLazyOpenDml {
    -- Manual mode (auto_commit off), no open transaction, statement is DML. Per pgjdbc's
    -- lazy BEGIN — setAutoCommit(false) does not BEGIN immediately; the next statement does
    -- — this opens a Pending(Unspecified) tx and resolves it by the normal rules: DML →
    -- Writing (no basis — writes don't read), with the DML buffered. Open + resolve are one
    -- step here because the resolution rules trigger on a tx that is already open; a freshly
    -- lazily-opened tx must resolve within the same statement.
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = dml
    requires: connection.tx = null
    requires: not connection.auto_commit

    ensures:
        let buffer = DmlBuffer.created(ops: { statement })
        Writing.created(
            connection: connection,
            failed: false,
            tx_default_tz: connection.default_tz,
            session_default_tz: connection.default_tz,
            buffer: buffer,
            commit_opts: CommitOpts(
                system_time: null,
                user_metadata: null,
                async: false
            )
        )
}

rule ManualLazyOpenQuery {
    -- Manual mode (auto_commit off), no open transaction, statement is a query. Per pgjdbc's
    -- lazy BEGIN, this opens a Pending(Unspecified) tx and pins its basis by the normal rules
    -- (see FirstQueryPinsReadBasis): the connection's await_token is awaited, then the
    -- latest-completed snapshot and current-time are captured, making the tx Reading. Because the
    -- Reading tx persists, subsequent reads in the manual transaction share this one snapshot —
    -- this is the manual-mode transaction's cross-statement snapshot isolation. Open + pin are
    -- one step (see ManualLazyOpenDml).
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = query
    requires: connection.tx = null
    requires: not connection.auto_commit

    ensures:
        let opened = Reading.created(
            connection: connection,
            failed: false,
            tx_default_tz: connection.default_tz,
            session_default_tz: connection.default_tz,
            read_basis: ReadBasis(
                snapshot_token: Database.snapshotToken,
                snapshot_time: null,
                clock_time: now
            ),
            await_token: null
        )
        Database.openSnapshot(basis: opened.read_basis)
}

rule BufferDml {
    -- An explicit transaction is open: buffer the DML into it, even when auto_commit is
    -- on. Rejected if the open tx is read-only (see DmlInReadOnlyRejected) or failed
    -- (see FailedTransactionRejectsStatements).
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = dml
    requires: connection.tx != null
    requires: connection.tx.mode = Writing
    requires: not connection.tx.failed

    ensures:
        connection.tx.buffer.ops.add(statement)

    @guidance
        -- Consecutive same-SQL ops coalesce: rather than appending a distinct op, the
        -- args are appended column-major into the trailing op when its SQL text matches.
        -- This is a buffer-internal representation detail; observably the op is buffered.
}

rule QueryInWritingRejected {
    -- Writing is write-only: a query in a Writing transaction is rejected. The
    -- `not failed` guard yields failed-first precedence: on a failed tx,
    -- FailedTransactionRejectsStatements fires instead (unambiguous).
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = query
    requires: connection.tx != null
    requires: connection.tx.mode = Writing
    requires: not connection.tx.failed

    ensures:
        StatementRejected(error_code: `xtdb/queries-in-read-write-tx`)
}

rule DmlInReadOnlyRejected {
    -- A transaction is read-only when it is Reading, or Pending with ReadOnly characteristics;
    -- DML in one is rejected. The `not failed` guard yields failed-first precedence: on a failed
    -- tx, FailedTransactionRejectsStatements fires instead (unambiguous).
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = dml
    requires: connection.tx != null
    requires: connection.tx.mode = Reading or (connection.tx.mode = Pending and connection.tx.characteristics = ReadOnly)
    requires: not connection.tx.failed

    ensures:
        StatementRejected(error_code: `xtdb/read-only-tx`)
}

rule QueryInReading {
    -- A query in a Reading transaction observes the pinned read basis. The basis is
    -- threaded to the Database so reads see exactly that point-in-time.
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = query
    requires: connection.tx != null
    requires: connection.tx.mode = Reading
    requires: not connection.tx.failed

    ensures:
        Database.openSnapshot(basis: connection.tx.read_basis)
}

rule AutoCommitQuery {
    -- Autocommit, no open transaction: the query transiently promotes to a read-only
    -- transaction. It resolves its basis to the connection's CURRENT basis (await_token +
    -- current-time) at this moment, reads against it, then discards — each autocommit read
    -- is fresh, with no cross-statement snapshot. Behaviourally identical to reading at the
    -- current await_token; framed as a transient per-statement Reading tx so that every
    -- read in the model runs inside a read-only transaction.
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: kind = query
    requires: connection.tx = null
    requires: connection.auto_commit

    ensures:
        Database.openSnapshot(
            basis: ReadBasis(
                snapshot_token: connection.await_token,
                snapshot_time: null,
                clock_time: now
            )
        )

    @guidance
        -- The transient read-only tx is not materialised as a Transaction entity: it opens,
        -- resolves its basis, reads and discards within the single statement. The contrast
        -- with the manual-mode lazy-open path (ManualLazyOpenQuery) is the lifetime — there
        -- the Reading tx persists and its basis is shared across subsequent reads.
}

rule FailedTransactionRejectsStatements {
    -- A transaction that has failed (aborted) rejects all further statements until it is
    -- rolled back. Applies to both queries and DML, on either resolved mode.
    when: ExecuteStatement(frontend, connection, kind, statement)
    requires: connection.tx != null
    requires: connection.tx.failed

    ensures:
        StatementRejected(error_code: `xtdb/tx-failed`)
}

---- Rules: Commit and Rollback

-- SQL COMMIT / ROLLBACK act on the explicit transaction regardless of auto_commit.
-- Programmatic commit() / rollback() are valid only when auto_commit is off.

rule CommitWriting {
    -- Commit of a Writing transaction drains the buffer and crosses the Database
    -- boundary EVEN IF the buffer is empty: async commit submits (fire-and-forget),
    -- sync commit executes-and-awaits. The submit anchors in the tx's tx_default_tz. COMMIT
    -- also writes the tx's session_default_tz back to the connection, so a mid-tx SET TIME
    -- ZONE persists past the tx while a BEGIN or SET TRANSACTION TIMEZONE (which never touches session_default_tz) does not.
    --
    -- The effective async choice: a commit-time COMMIT SYNC / COMMIT ASYNC (commit_mode) wins;
    -- otherwise the transaction's begin-time CommitOpts.async flag decides. Only the SOURCE of
    -- the submit-vs-execute decision gains the override — the split itself is unchanged.
    when: CommitTransaction(frontend, connection, commit_mode)
    requires: connection.tx != null
    requires: connection.tx.mode = Writing
    requires: not connection.tx.failed

    ensures:
        let ops = connection.tx.buffer.ops
        let opts = {
            user: connection.user,
            default_tz: connection.tx.tx_default_tz,
            system_time: connection.tx.commit_opts.system_time,
            user_metadata: connection.tx.commit_opts.user_metadata
        }

        let async =
            if commit_mode = async: true
            else if commit_mode = sync: false
            else: connection.tx.commit_opts.async

        connection.default_tz = connection.tx.session_default_tz

        if async:
            Database.submitTx(ops: ops, opts: opts)
        else:
            Database.executeTx(ops: ops, opts: opts)

        AwaitTokenAdvanced(connection: connection)
        not exists connection.tx

    @guidance
        -- "even if empty" is deliberate: an explicit COMMIT of a Writing tx that
        -- buffered nothing still submits an empty transaction. This differs from the
        -- Reading / Pending no-op below.
}

rule CommitNoOp {
    -- Commit of a Reading or still-Pending transaction submits nothing — there is no
    -- buffer to drain. It still writes the tx's session_default_tz back to the connection
    -- (COMMIT writes the session tz back regardless of mode, before the Writing / no-op
    -- split), so a mid-tx SET TIME ZONE persists on a read-only commit too. The transaction
    -- then closes. commit_mode is irrelevant here — there is nothing to submit, so the
    -- submit-vs-execute override has no effect.
    when: CommitTransaction(frontend, connection, commit_mode)
    requires: connection.tx != null
    requires: connection.tx.mode = Reading or connection.tx.mode = Pending
    requires: not connection.tx.failed

    ensures:
        connection.default_tz = connection.tx.session_default_tz
        not exists connection.tx
}

rule Rollback {
    -- Rollback discards the open transaction (and its buffer, if any), submitting
    -- nothing. Valid even on a failed transaction — this is how a failed tx is cleared.
    -- The connection's default_tz reverts implicitly: it was never mutated while the tx was
    -- open (a mid-tx SET TIME ZONE writes the tx's tx_default_tz / session_default_tz, not
    -- the connection), so dropping the tx discards any mid-transaction SET TIME ZONE.
    -- Postgres semantics — a plain SET in an aborted tx is rolled back; only COMMIT keeps
    -- the new zone (see CommitWriting / CommitNoOp).
    when: RollbackTransaction(frontend, connection)
    requires: connection.tx != null

    ensures:
        not exists connection.tx
}

rule ProgrammaticCommitInAutoCommitRejected {
    -- Programmatic commit() is valid only when auto_commit is off.
    when: ProgrammaticCommit(frontend, connection)
    requires: connection.auto_commit

    ensures:
        CommitRejected(error_code: `xtdb.adbc/commit-in-autocommit`)
}

rule ProgrammaticRollbackInAutoCommitRejected {
    -- Programmatic rollback() is valid only when auto_commit is off.
    when: ProgrammaticRollback(frontend, connection)
    requires: connection.auto_commit

    ensures:
        RollbackRejected(error_code: `xtdb.adbc/rollback-in-autocommit`)
}

rule DisableAutoCommitCommitsOpen {
    -- setAutoCommit(false) when already off is a no-op; turning it ON commits any open
    -- transaction first (so buffered work is not silently stranded), then sets the flag.
    when: SetAutoCommit(frontend, connection, enabled)
    requires: enabled
    requires: not connection.auto_commit

    ensures:
        if connection.tx != null:
            CommitTransaction(frontend: frontend, connection: connection, commit_mode: null)
        connection.auto_commit = true
}

---- Rules: Connection Close

rule CloseConnection {
    -- Closing the connection discards any open transaction WITHOUT submitting. Buffered
    -- but uncommitted work is lost — closing is not an implicit commit.
    when: CloseConnection(frontend, connection)

    ensures:
        if connection.tx != null:
            not exists connection.tx
}

---- Invariants

invariant WritingCarriesCommitOpts {
    -- Commit-opts exist only on a Writing transaction: their presence implies Writing
    -- (grammar-enforced at BEGIN). The variant structure makes this hold by construction;
    -- stated here as the cross-cutting property.
    true
}

invariant ReadBasisPinnedAtFirstQuery {
    -- The read basis is pinned at the transaction's first query, which takes a Pending tx to
    -- Reading; a Writing tx has none — writes don't read. Structural — stated here as the
    -- cross-cutting property.
    true
}

invariant EffectiveAwaitToken {
    -- The await token SHOW reports for an open tx is the Reading tx's override, or the
    -- Pending(ReadOnly) tx's, else the connection's.
    true
}

invariant TxReadOnlyForFrontend {
    -- The frontend's read-only checks treat a tx as read-only when it is Reading, or Pending
    -- with ReadOnly characteristics.
    true
}

---- Actor Declarations

actor FrontendActor {
    -- Either protocol frontend (pgwire or ADBC / Flight SQL). Any Frontend may drive a
    -- connection through the surfaces below.
    identified_by: Frontend where true
}

---- Surfaces

surface TxControlAsSql {
    -- The shared path: tx-control expressed as SQL, classified by the SqlParser. This is
    -- the full surface — an ADBC / Flight SQL client reaches the entire model here.
    facing frontend: FrontendActor

    context conn: Connection

    provides:
        BeginTransaction(frontend, conn, access_mode, read_only_opts, commit_opts, tz_override)
            when conn.tx = null
        SetTransaction(frontend, conn, access_mode, read_only_opts, commit_opts, tz_override)
        ExecuteStatement(frontend, conn, kind, statement)
        SetTimeZone(frontend, conn, zone)
        CommitTransaction(frontend, conn, commit_mode)
            when conn.tx != null
        RollbackTransaction(frontend, conn)
            when conn.tx != null

    @guarantee SingleOpenTransaction
        -- At most one transaction is open on a connection at any time.

    @guarantee WriteOnlyWriting
        -- A Writing transaction rejects queries; a read-only transaction rejects DML.

    @guarantee ConnectionScopedIdentity
        -- Every transaction this connection submits is stamped with the connection's
        -- user; it is not a per-transaction option.
}

surface AdbcBasicControl {
    -- Retained programmatic control on the ADBC AdbcConnection surface: a strict subset
    -- of TxControlAsSql, kept for driver ergonomics.
    facing frontend: FrontendActor

    context conn: Connection

    provides:
        SetAutoCommit(frontend, conn, enabled)
        ProgrammaticCommit(frontend, conn)
            when not conn.auto_commit
        ProgrammaticRollback(frontend, conn)
            when not conn.auto_commit

    @guarantee ProgrammaticControlNeedsManualMode
        -- Programmatic commit / rollback are valid only when auto_commit is off.
}

surface ConnectionLifecycle {
    facing frontend: FrontendActor

    context conn: Connection

    provides:
        CloseConnection(frontend, conn)

    @guarantee CloseDiscardsOpenTx
        -- Closing the connection discards any open transaction without submitting.
        -- Closing is not an implicit commit.
}

---- Open Questions

open question "AutoCommitDml stamps opts with user and default_tz only (no system_time). Is the read basis (await_token) the right post-write visibility contract for the immediately-following auto-commit query, or should auto-commit DML and the following query share a tighter basis?"
