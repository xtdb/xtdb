-- allium: 3
-- log-processor-lifecycle.allium
--
-- Scope: leader election for one database on one node.
-- A node reading a database's replica log claims leadership in that same log, leads as the sole writer of it for its term, and stands down when a higher term supersedes it.
-- Includes: the Following/Leading state machine; how a claim is made and adjudicated; the term fence that keeps at most one CONFIRMED leader per database; the obligations the replica log itself has to meet for a term to mean anything.
-- Excludes: record processing and the block lifecycle (db.allium), the live index (live-index.allium), the external source.
--
-- live-index.allium treats WHICH role owns the live index as a given.
-- This spec says how that role is selected and swapped, and does not restate what the roles then do with it.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Database {
    -- The database whose replica log this node reads.
    -- Its lifecycle governs the terms below: tearing the database down ends whichever term is live.
    name: String
}

external entity FollowerTerm {
    -- A follower: consumes the replica log to build local queryable state.
    --
    -- A block is in flight on this node: a boundary read, and no confirmation of the block read back yet.
    -- Either the block is still to be produced, or a term produced it and ended before reading its own confirmation.
    mid_block: Boolean
}

external entity LeaderTerm {
    -- A leader: consumes the SOURCE log, resolves client transactions, and writes the replica log.
    --
    -- term is this leader's fencing term, stamped onto every replica record the term writes.
    -- It is taken from the replica log itself — one above the highest term this node has read — so it needs nothing outside the log to keep it rising.
    --
    -- The fence is applied on CONSUME-BACK rather than at write time: reading back a record whose term exceeds this one means a newer leader has superseded us, and this node stands down where it reads it.
    -- So there is no fencing token and no write-time failure — the term stamp plus the consume-back check is the whole fence.
    --
    -- Every record the term writes also carries its position within the term.
    -- The claim that opened the term is position 0, and its leader numbers everything it writes after that consecutively from 1, in the one order it appends them.
    term: Integer

    -- A term ends itself — superseded, or failed — so it is over before the node has reconciled the role it still holds.
    -- False from that moment until the read reconciles it (ReopenFollowerOnTermEnded).
    is_live: Boolean

    -- A block this term has produced and not yet adopted: produced during the promotion, adopted on reading a confirmation of it back.
    -- A term ending in between hands it to the role that replaces it.
    mid_block: Boolean
}

external entity ReplicaLog {
    -- The database's replica log: the durable, totally-ordered sequence of records a follower replays to build local state, and a leader writes and reads back.
    -- It is also where leadership is settled, and it takes no part in settling it: who leads is a function of its contents, which every reader computes alike.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value MessageId {
    -- A replica-log message position.
    offset: Integer
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DurableTotalOrder {
    -- What the replica log must supply for a term to mean anything.
    --
    -- append returns the position the record now occupies; read_after delivers the records above a position and returns the position reached.
    append: (log: ReplicaLog, term: Integer) -> MessageId
    read_after: (log: ReplicaLog, after: MessageId) -> MessageId

    @invariant AppendReturnsItsOwnPosition
        -- An accepted append tells its author which position the record now occupies.
        --   A claim is identified by nothing but its position, so an author that could not learn where its own record landed could not tell its claim from anyone else's.

    @invariant OneAcceptedAppendYieldsOneRecord
        -- An accepted append puts exactly one record in the log, a refused one puts none, and the author is told which happened.
        --   A claim that landed twice occupies two positions, only one of which its author is watching for; the other confers leadership on a node that will never notice.

    @invariant OneOrderSeenByEveryReader
        -- Every reader of a log sees the same records at the same positions.
        --   Leadership is a function of position, so two readers disagreeing about the order would disagree about who leads.

    @invariant DeliveryFollowsPositionOrder
        -- A reader is delivered records in position order, and reaching a position means having been delivered everything below it.
        --   Independent of OneOrderSeenByEveryReader, which fixes where each record sits rather than the order a reader meets them in.
        --   Because the fence is applied on consume-back, a leader silently handed a gap can miss the higher-term record that supersedes it and confirm writes every other reader discards.
        --   A read that would skip a position has to fail rather than proceed.
        --   Within a term, a record the log lost while later records of that term landed is caught by every reader as a gap in the term's positions, and voids the rest of the term (VoidTermOpenedPastItsStart, VoidTermOnGap).
        --   A loss with nothing later from its own term behind it leaves no gap to catch, and neither does any loss in an unsequenced term.

    @invariant EmptyReadMeansTheTipWasReached
        -- A read returns empty only when the reader that issued it has reached the log's tip.
        --   This is the observation a claim is made on, and it is the reader's own: it had to ask.
        --   A log reporting empty on its own account would let a node that has stopped reading claim over a leader it can no longer see, fence that leader, fail to confirm its own claim, and repeat.

    @invariant AcceptedRecordsAreNeverWithdrawn
        -- Once an append is accepted, its record is never removed, replaced or moved while it stays above the retention boundary.
        --   Ordinarily a durability property; here a safety one, because a term reaches another node only as a record.
        --   Withdrawing one after that node has read it lets the two disagree about which term the log has reached, which is the one thing the fence cannot survive.

    @invariant RetentionKeepsEverythingAboveTheBoundary
        -- Records at or above the persisted block boundary's position are retained; reclaiming those below it is expected.
        --   A term is seeded from that boundary and monotonic from there, so this is both what lets a starting node catch up at all and what puts a floor under the fence.
        --   Reclaiming a record that still sits above the boundary would unmoor the highest term read from the log it is meant to describe.

    @invariant DurabilityIsConfiguredNotHoped
        -- Expected of the operator: AcceptedRecordsAreNeverWithdrawn has to hold in the DEPLOYED configuration, and nothing in here can enforce it.
        --   A log that acknowledges an append before the record is held widely enough to survive a failure, or that lets a replica which never received it take over, withdraws a record it has already promised.
        --   Caught as the database connects this is an error message; caught later it is two nodes disagreeing about the term.
}

contract Election {
    -- How leadership is decided, given a replica log meeting DurableTotalOrder.
    --
    -- claim appends a no-op above the highest term the claimant has read; confers answers whether a record at a position took leadership.
    claim: (processor: LogProcessor) -> MessageId
    confers: (processor: LogProcessor, at: MessageId) -> Boolean

    @invariant PositionDecidesTheClaim
        -- A claim confers leadership exactly when nothing at or above its term precedes it in the log.
        --   The claim's position is the whole of the answer, so every node computes the same one from the same prefix and nothing passes between nodes.
        --   Two claims at the same term are settled by which of them the log put first.
        --   A claim's position within its term, 0, plays no part in adjudicating it.

    @invariant ATermIsSequencedIffItsClaimIs
        -- A term's records are checked against their positions exactly when the claim that won it carries one.
        --   A claim written by a node predating positions carries none, and the term it wins is unsequenced: nothing in it is checked.

    @invariant ClaimFollowsObservation
        -- A node claims only from something it has read: a read of its own that came back empty, a record that voided the term it holds, or the absence of any term in the state it started from.
        --   A claim fences the incumbent whether or not it wins, so a node that could claim without reading would supersede a leader it cannot see, fail to confirm its own claim, and supersede the next leader in turn.

    @invariant ClaimsRiseAboveWhatWasRead
        -- A claim carries a term strictly above the highest the claimant has read.
        --   A claim at or below it confers nothing, so this is what makes a claim capable of winning at all.

    @invariant ConcurrentClaimantsConverge
        -- Two nodes finding the log quiet at once settle on one leader in bounded time.
        --   Each read's length is drawn afresh, so nodes that claimed together next claim at different moments.
        --   A losing claim is a record, so reading it back ends the loser's read and redraws it.

    @invariant ExactlyOneConfirmedLeaderPerDatabase
        -- At most one leader's writes are ever CONFIRMED per database, enforced by the term fence on consume-back — Raft's ReadIndex, with no transactional append.
        -- Each leader stamps its replica writes with its own term.
        -- A leader confirms — and so acknowledges — a write only when it reads that write back at its OWN term; reading back a HIGHER term means a newer leader has superseded it, so it stands down without confirming its outstanding writes.
        -- Two nodes may therefore briefly both believe themselves leader and both append, but only the newer term's writes are ever confirmed, and the older leader's are discarded.

    @invariant LiveLeadershipIsVisibleOnTheLog
        -- A leader writes to the replica log within a bounded interval of its last write, whether or not it has work.
        --   - With traffic: met by the writes it is making anyway.
        --   - Idle: a no-op stamped with its own term.
        --   Otherwise a quiet database and a leaderless one are the same log to a reader.

    @invariant StandingDownLeavesTheDatabaseReadable
        -- A node that stands down for a higher term leaves its database queryable on that node.
        --   The end of a term reaches everything it was driving, the external source included, each of which reports a role that has changed rather than a database that has failed.

    @invariant ARefusedClaimLeavesTheDatabaseReadable
        -- A node whose claim the replica log will not accept goes on following, indexing and answering queries.
        --   A claim is speculative, so the node forfeits nothing it held, and its next quiet read claims again.
        --   Every follower claims when its read comes back empty, so a log that has stopped accepting writes is one every follower meets at once: treating the refusal as this node's fault would stop the readers of every one of them, over a write none of them had to make.

    @invariant OneReplicaReaderPerDatabase
        -- One read of the replica log serves whichever role is live; the leader additionally consumes the source log.
        --   So a role change continues from the position that read has reached, and no replica record is skipped across one.
        --   It outlives every term it drives, a promotion that failed to start one included, so reading ends only with the database's membership.

    @invariant RoleIsAlwaysBackedByALiveTerm
        -- No record is ever applied through a term that has ended.
        --   A promotion stops its follower before it publishes its leader, so a promotion that fails in between has to re-open a live follower (RecoverFollowerOnFailedPromotion).
        --   A term that ends on its own leaves the role standing until the next read reconciles it (ReopenFollowerOnTermEnded). Through that window the node reports itself as no longer leading, and a record offered to the ended role is re-offered to the follower that replaces it.

    @invariant APendingBlockOutlivesTheRoleHoldingIt
        -- A block produced and not adopted MUST reach the role that replaces the one holding it, in either direction.
        --   The adopt is what moves this node's catalog past the block, so that a confirmation of it does not read as stale.
        --   A role that holds no block to match a confirmation against stops the node's replica reading, and the database with it.

    @invariant HeldRecordsAreAppliedOrTheDatabaseStops
        -- A role that has adopted a block applies every record held behind that block, or the database stops on this node.
        --   Reading advanced past those records while they were held, so they are consumed off the log before the adopt and nothing re-reads them.
        --   The adopt is what moves this node's catalog past the block, so from that point the block's confirmation reads as stale and a role re-opened afterwards discards it — taking the records held behind it with it.
        --   A node carrying on from there would answer queries for a database missing transactions the log holds and every other node has.
        --   Before the adopt the block and the records travel together, so a role that ends hands both to the one that replaces it and a later election runs the whole thing again.
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity LogProcessor {
    -- One database's role on one node, and the read that drives it. Starts Following.
    --
    -- That read is the only writer of the role, so a role change needs no coordination with anything else on the node.
    database: Database

    -- The log this processor reads, claims in, and is fenced against.
    replica_log: ReplicaLog

    -- Reading the replica log belongs to the node rather than to either term: one read feeds whichever role is live, a follower building state and a leader confirming its own writes alike.
    -- Every record read advances this, applied or discarded, so a role change continues from it rather than restarting — which is why it is held here and not on a term.
    replica_pos: MessageId

    -- The role.
    --   following  -- holds a live follower term.
    --   leading    -- holds a live leader term.
    state: following | leading

    transitions state {
        following -> leading     -- a claim of ours was read back and conferred
        leading -> following     -- the leader term ended
        -- No terminal state: a processor cycles following/leading indefinitely.
    }

    -- The highest term this node has read.
    -- Every election question is asked of this one: a claim carries the term one above it, confers exactly when the record it is read back at carries a term above it, and a record below it is discarded.
    -- Scoped to the database for the node's whole life rather than to a role: seeded once from the persisted block boundary, and monotonic from there.
    -- Held per role it would be reseeded from that boundary at every role change, forgetting every term written since the last block flush — so the same term could be admitted twice, once either side of a role change.
    highest_term_read: Integer

    -- How far through the highest term read this node has got.
    --   unsequenced -- the term was opened by a record carrying no position, so nothing in it is checked.
    --   unknown     -- resumed from a block boundary carrying no position, so the next record's position is taken as given, unless it is a claim, which has lost.
    --   expecting   -- the term's next record has to carry next_term_seq.
    --   voided      -- a record of this term never reached the log, so nothing further in it applies.
    -- Scoped and seeded with highest_term_read, and for the same reason.
    -- Seeded from the persisted block boundary: expecting the boundary's position + 1 in the boundary's term; unknown where the block carries no boundary position; unsequenced at term 0.
    term_position: unsequenced | unknown | expecting | voided
    next_term_seq: Integer when term_position = expecting

    transitions term_position {
        unknown -> unsequenced      -- resumed, and the next record carries no position
        unknown -> expecting        -- resumed, and the next record's position, other than 0, taken as given; or a higher term opened by its claim
        unknown -> voided           -- a higher term opened past its claim
        unsequenced -> expecting    -- a higher term opened by its claim
        unsequenced -> voided       -- a higher term opened past its claim
        expecting -> unsequenced    -- a higher term opened with no position
        expecting -> voided         -- a gap in this term, or a higher term opened past its claim
        voided -> expecting         -- a higher term opened by its claim
        voided -> unsequenced       -- a higher term opened with no position
        -- No terminal state: a higher term always re-opens the position.
    }

    -- Whether this node is permitted to lead at all. Fixed for its life: a read-only database is reconfigured by replacing it.
    may_lead: Boolean

    -- The live follower term, present while Following.
    follower_term: FollowerTerm when state = following

    -- The position of a claim of ours that is in flight, present while Following and while one is outstanding.
    claim_pos: MessageId when state = following

    -- The live leader term, present while Leading.
    leader_term: LeaderTerm when state = leading

    -- Derived: this node is the leader for its database, and holds a live term to lead with.
    is_leading: state = leading and leader_term.is_live
}

------------------------------------------------------------
-- Rules: claim leadership
--
-- Three observations admit a claim, and all are the node's own.
------------------------------------------------------------

rule ClaimOnEmptyRead {
    -- A read of this node's own returned nothing, so the log is at its tip and whoever last led it has stopped writing.
    when: ReadReturnedEmpty(processor)

    requires: processor.state = following
    requires: processor.may_lead
    requires: processor.claim_pos = null

    ensures:
        processor.claim_pos = ClaimAppended(term: processor.highest_term_read + 1, term_seq: 0)
}

rule ClaimOnVoidedTerm {
    -- A voided term confirms nothing further, so there is no incumbent to wait out: the node claims on the record that voided it rather than on a later empty read.
    -- Every reader meets the void at the same record, so the claims tend to land together at the same term, and the log's order settles them like any others.
    -- A leader meeting its own term voided claims once ResignOnVoidedTerm has re-opened it as a follower.
    when: TermVoided(processor, term)

    requires: processor.state = following
    requires: processor.may_lead
    requires: processor.claim_pos = null

    ensures:
        processor.claim_pos = ClaimAppended(term: processor.highest_term_read + 1, term_seq: 0)
}

rule ClaimWhenNoTermHasLed {
    -- Nothing this node starts from names a term, so a claim at the bottom of the ordering is what settles whether anyone has led.
    -- Against a log that turns out to carry a term, the claim is read back behind it and confers nothing (ClaimConferredNothing), leaving the node holding the term it must now claim above.
    -- Against one that does not, nothing can precede it, so it confers at once and spares a database nobody has ever led an election before its first write.
    when: ProcessorStarted(processor)

    requires: processor.state = following
    requires: processor.may_lead
    requires: processor.highest_term_read = 0

    ensures:
        processor.claim_pos = ClaimAppended(term: 1, term_seq: 0)
}

------------------------------------------------------------
-- Rules: fold a record into the term position
--
-- Every reader folds every record through these before either role acts on it, so every reader reaches the same verdict on each whatever its role.
-- A record these neither discard nor void is applied, which is db.allium's.
-- Claim adjudication reads highest_term_read as it stood before the claim's own fold.
------------------------------------------------------------

rule DiscardRecordBelowTheFence {
    -- A record written by a leader the log has moved past.
    --   Application is suppressed; consumption is not, so a reader catching up never stalls on one.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term < processor.highest_term_read

    ensures:
        processor.replica_pos = pos
}

rule OpenTermAtItsClaim {
    -- A higher term, opened by the claim that won it.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term > processor.highest_term_read
    requires: term_seq = 0

    ensures:
        processor.highest_term_read = term
        processor.term_position = expecting
        processor.next_term_seq = 1
}

rule OpenUnsequencedTerm {
    -- A higher term, opened by a record carrying no position: written by a node predating positions.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term > processor.highest_term_read
    requires: term_seq = null

    ensures:
        processor.highest_term_read = term
        processor.term_position = unsequenced
}

rule VoidTermOpenedPastItsStart {
    -- A higher term whose first record here is not its claim: the records before it never reached the log.
    --   The term is voided from that first record, which is consumed and never applied.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term > processor.highest_term_read
    requires: term_seq != null and term_seq != 0

    ensures:
        processor.highest_term_read = term
        processor.term_position = voided
        processor.replica_pos = pos
        TermVoided(processor: processor, term: term)
}

rule TakeResumedPositionAsGiven {
    -- A record of the boundary's term, after resuming from a block that carries no boundary position.
    -- One carrying no position makes the term unsequenced; any position but 0 is taken as given.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term = processor.highest_term_read
    requires: processor.term_position = unknown
    requires: term_seq != 0

    ensures:
        if term_seq = null:
            processor.term_position = unsequenced
        else:
            processor.term_position = expecting
            processor.next_term_seq = term_seq + 1
}

rule DiscardClaimAfterResumedBoundary {
    -- A claim at the boundary's term, read after resuming from a block that carries no boundary position.
    --   The term's winning claim precedes the boundary, so this one has lost: it is discarded, and the position stays unknown.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term = processor.highest_term_read
    requires: processor.term_position = unknown
    requires: term_seq = 0

    ensures:
        processor.replica_pos = pos
}

rule AdmitNextInTerm {
    when: RecordRead(processor, pos, term, term_seq)

    requires: term = processor.highest_term_read
    requires: processor.term_position = expecting
    requires: term_seq = processor.next_term_seq

    ensures:
        processor.next_term_seq = processor.next_term_seq + 1
}

rule DiscardBehindTermPosition {
    -- A losing claim at this term, or a duplicate.
    --   In a sequenced term a record carrying no position can only be a losing claim from a node predating positions.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term = processor.highest_term_read
    requires: processor.term_position = expecting
    requires: term_seq = null or term_seq < processor.next_term_seq

    ensures:
        processor.replica_pos = pos
}

rule VoidTermOnGap {
    -- A record ahead of the position this term expects: the one between never reached the log.
    --   The rest of the term is voided, this record included: consumed, and never applied.
    when: RecordRead(processor, pos, term, term_seq)

    requires: term = processor.highest_term_read
    requires: processor.term_position = expecting
    requires: term_seq != null and term_seq > processor.next_term_seq

    ensures:
        processor.term_position = voided
        processor.replica_pos = pos
        TermVoided(processor: processor, term: term)
}

rule DiscardInVoidedTerm {
    when: RecordRead(processor, pos, term, term_seq)

    requires: term = processor.highest_term_read
    requires: processor.term_position = voided

    ensures:
        processor.replica_pos = pos
}

------------------------------------------------------------
-- Rules: adjudicate a claim
--
-- A claim is read back like any other record, so by the time it is judged it has already been applied.
------------------------------------------------------------

rule ClaimConferredLeadership {
    when: RecordRead(processor, pos, term, term_seq)

    requires: processor.state = following
    requires: pos = processor.claim_pos
    requires: term > processor.highest_term_read

    ensures:
        -- Stop the follower first: it goes on acting on records until it stops, and one of them may be the confirmation that closes its block.
        FollowerStopped(follower_term: processor.follower_term)

        -- Produce any block an earlier leader left dangling: this leader writes its files and appends the confirmation, under its own term.
        -- Requires the follower stopped, so the block cannot be produced twice.
        -- It is not adopted here. This term adopts it, and applies what the follower was holding behind it, on reading a confirmation of it back — db.allium owns the adopt.
        -- That confirmation is this term's own, or the outgoing leader's where that term got one away before it ended: both confirm the same block, and the adopt takes whichever the fence admits first.
        -- So the block stays in flight across the promotion, and a term that ends before adopting it hands it on again (ReopenFollowerOnTermEnded).
        if processor.follower_term.mid_block:
            DanglingBlockProduced(follower_term: processor.follower_term)

        processor.leader_term = LeaderTerm.created(
            term: term,
            is_live: true,
            mid_block: processor.follower_term.mid_block
        )
        processor.follower_term = null
        processor.claim_pos = null
        processor.state = leading

        -- Source-log delivery resumes at the last applied source position, which db.allium owns.
        SourceDeliveryResumed(processor: processor)
}

rule ClaimConferredNothing {
    -- A claim the log put behind a term at or above it. The claimant keeps following, and is free to claim again from what it has now read.
    when: RecordRead(processor, pos, term, term_seq)

    requires: processor.state = following
    requires: pos = processor.claim_pos
    requires: term <= processor.highest_term_read

    ensures:
        processor.claim_pos = null
        processor.state = following
}

------------------------------------------------------------
-- Rules: stand down
--
-- A leader term ends itself — superseded, or failed — so the node re-opens a follower when it finds the term over.
------------------------------------------------------------

rule ReopenFollowerOnTermEnded {
    when: LeaderTermEnded(processor)

    requires: processor.state = leading

    ensures:
        -- Re-open a follower. The durable live index is untouched, and so is the read position: the read spans the role change, so the follower continues from where the term left off.
        -- A block the term produced and did not adopt goes with it, so the follower closes it on a confirmation of that block that the fence admits.
        -- It is read once the term has ended: the term goes on applying records until then, and one of them may be that confirmation.
        processor.follower_term = FollowerTerm.created(mid_block: processor.leader_term.mid_block)
        processor.leader_term = null
        processor.state = following
}

rule ResignOnVoidedTerm {
    -- A leader that meets a voided term has nothing further to read back at or below it, so its term ends where the record is read, without confirming its outstanding writes.
    when: TermVoided(processor, term)

    requires: processor.state = leading

    ensures:
        processor.leader_term.is_live = false
        LeaderTermEnded(processor: processor)
}

rule RecoverFollowerOnFailedPromotion {
    -- The promotion stops the follower before it publishes the leader, so a failure in between leaves the role holding a term that can no longer advance.
    -- Re-opening a live follower is what keeps RoleIsAlwaysBackedByALiveTerm true through that window.
    when: PromotionFailed(processor)

    requires: processor.state = following

    ensures:
        -- Seeded from the follower the promotion stopped, so a block it was holding — produced by this promotion or not — is still in flight and still has a role to close it.
        processor.follower_term = FollowerTerm.created(mid_block: processor.follower_term.mid_block)
        processor.claim_pos = null
        processor.state = following
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RoleHasItsTerm {
    -- Whatever role the node holds, it holds the matching term.
    -- That the term is also LIVE is RoleIsAlwaysBackedByALiveTerm, which this cannot express.
    for processor in LogProcessors:
        (processor.state = leading implies processor.leader_term != null)
        and (processor.state = following implies processor.follower_term != null)
}

invariant OnlyAnEligibleNodeHoldsAClaim {
    -- A node that may not lead never has a claim outstanding, and so never leads.
    for processor in LogProcessors:
        (not processor.may_lead) implies (processor.claim_pos = null and processor.state = following)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Node {
    -- The node this processor runs on. It opens the processor and reads its replica log, which is where every event below comes from.
    -- Identified by the database it is reading.
    identified_by: Database where name != ""
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ReplicaLogReading {
    -- What a node's own reading of the replica log tells its role.
    -- Every event here is that node's own observation, which is what ClaimFollowsObservation turns on.
    facing node: Node

    context processor: LogProcessor

    exposes:
        processor.state
        processor.highest_term_read
        processor.is_leading

    provides:
        -- The processor opened, before it has read anything.
        ProcessorStarted(node, processor) when processor.state = following

        -- A read of this node's own came back empty, so it has reached the log's tip.
        ReadReturnedEmpty(node, processor) when processor.state = following

        -- A record was delivered at a position, carrying a term and its position within that term, absent where the node that wrote it predates positions.
        RecordRead(node, processor, pos, term, term_seq)

        -- The leader term ended — superseded by a higher term, or failed.
        LeaderTermEnded(node, processor) when processor.state = leading

        -- The promotion stopped the follower and then failed before publishing the leader.
        PromotionFailed(node, processor) when processor.state = following

    contracts:
        fulfils Election

    @guarantee LeadershipMovesWithoutCoordination
        -- Leadership moves between nodes with nothing exchanged between them, and nothing outside the database's own replica log consulted.
        --   So two deployments sharing a log cluster are isolated by their log names, and a database's leadership changes disturb no other database.

    @guarantee LeadershipPlacementIsUnbalanced
        -- Which node leads which database is whichever claimed first, and leadership moves only when a term ends.
        --   One node may lead several databases while another leads none, and the distribution does not even out on its own.

    @guarantee OneConfirmedLeaderViaTermFence
        -- At most one leader's writes are ever confirmed per database, enforced by the term fence on consume-back rather than by anything at this boundary.
        --   Which is why the log's own obligations are stated in this module at all: the fence is nothing but readers agreeing on which term the log has reached and how far through it, so it holds exactly as far as DurableTotalOrder does and no further.
}
