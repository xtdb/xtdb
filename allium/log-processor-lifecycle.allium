-- allium: 3
-- log-processor-lifecycle.allium
--
-- Scope: leader election for one database on one node.
-- A node following a database's replica log can be promoted to LEADER — the sole writer of that log for its term — and demoted back to following.
-- Includes: the Following/Leading state machine; the ordered steps a promotion runs and what each one buys; the term fence that keeps at most one CONFIRMED leader per database; the obligations the replica log itself has to meet for a term to mean anything.
-- Excludes: record processing and the block lifecycle (db.allium), the live index (live-index.allium), the external source.
--
-- live-index.allium treats WHICH role owns the live index as a given.
-- This spec says how that role is selected and swapped, and does not restate what the roles then do with it.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Database {
    -- The database whose replica log this node follows or leads.
    -- Its lifecycle governs the terms below: tearing the database down ends whichever term is live, so an elector that releases a database need not also demote it.
    name: String
}

external entity FollowerTerm {
    -- A follower: consumes the replica log to build local queryable state.
    --
    -- A block is in flight on this node: a boundary read, and no confirmation of the block read back yet.
    -- Either the block is still to be produced, or a term produced it and ended before reading its own confirmation.
    mid_block: Boolean
}

external entity LeaderTerm {
    -- A leader: consumes the SOURCE log, resolves client transactions, and writes the replica log.
    --
    -- term is this leader's fencing term, stamped onto every replica record the term writes.
    -- It pairs an operator-declared epoch with the elector's own election counter, packed so that the epoch dominates the ordering.
    -- The epoch is what keeps terms rising across a reset of the elector's counter, which is otherwise free to regress — see ClaimUnfenced.
    --
    -- The fence is applied on CONSUME-BACK rather than at write time: reading back a record whose term exceeds this one means a newer leader has superseded us, and this node is demoted where it reads it.
    -- So there is no fencing token and no write-time failure — the term stamp plus the consume-back check is the whole fence.
    --
    -- The highest term this node has seen is scoped to the database for the node's whole life rather than to a role: seeded once from the persisted block boundary, and monotonic from there.
    term: Integer

    -- The replica-log position this term claimed, and caught up to before taking the role.
    replay_target: MessageId

    -- A block this term has produced and not yet adopted: produced during the promotion, adopted on reading a confirmation of it back.
    -- A term ending in between hands it to the role that replaces it.
    mid_block: Boolean
}

external entity ReplicaLog {
    -- The database's replica log: the durable, totally-ordered sequence of records a follower replays to build local state, and a leader writes and reads back.
    -- It is a party with obligations (DurableTotalOrder) rather than a participant in the lifecycle — who leads is the elector's decision, and the log neither knows nor cares.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value MessageId {
    -- A replica-log message position.
    offset: Integer
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DurableTotalOrder {
    -- What the replica log must supply for a term to mean anything.
    -- Obligations on the log rather than on whoever elects, so they hold however the role is decided.
    --
    -- append returns the position the record now occupies; read_after delivers the records above a position and returns the position reached.
    append: (log: ReplicaLog, term: Integer) -> MessageId
    read_after: (log: ReplicaLog, after: MessageId) -> MessageId

    @invariant AppendReturnsItsOwnPosition
        -- An accepted append tells its author which position the record now occupies.
        --   A promotion stamps a claim with its term and uses that record's own position as its replay target, which the follower catches up to.
        --   Without the position coming back from the append, the promotion would need a second handshake to learn where its own claim landed.

    @invariant OneAcceptedAppendYieldsOneRecord
        -- An accepted append puts exactly one record in the log, a refused one puts none, and the author is told which happened.
        --   A replay target that landed twice, or one whose outcome cannot be established, leaves the promotion catching up to a position other than the one it stamped — and taking the role believing it has read everything before its own term.

    @invariant OneOrderSeenByEveryReader
        -- Every reader of a log sees the same records at the same positions.
        --   The fence is nothing but readers agreeing on which term the log has reached.
        --   Two readers disagreeing about the order could disagree about that, and a superseded leader would go on confirming writes.

    @invariant DeliveryFollowsPositionOrder
        -- A reader is delivered records in position order, and reaching a position means having been delivered everything below it.
        --   Independent of OneOrderSeenByEveryReader, which fixes where each record sits rather than the order a reader meets them in.
        --   Because the fence is applied on consume-back, a leader silently handed a gap can miss the higher-term record that supersedes it and confirm writes every other reader discards.
        --   A read that would skip a position has to fail rather than proceed.

    @invariant AcceptedRecordsAreNeverWithdrawn
        -- Once an append is accepted, its record is never removed, replaced or moved while it stays above the retention boundary.
        --   Ordinarily a durability property; here a safety one, because a term reaches another node only as a record.
        --   Withdrawing one after that node has read it lets the two disagree about which term the log has reached, which is the one thing the fence cannot survive.

    @invariant RetentionKeepsEverythingAboveTheBoundary
        -- Records at or above the persisted block boundary's position are retained; reclaiming those below it is expected.
        --   A term is seeded from that boundary and monotonic from there, so this is both what lets a starting node catch up at all and what puts a floor under the fence.
        --   Reclaiming a record that still sits above the boundary would unmoor the highest term seen from the log it is meant to describe.

    @invariant DurabilityIsConfiguredNotHoped
        -- Expected of the operator: AcceptedRecordsAreNeverWithdrawn has to hold in the DEPLOYED configuration, and nothing in here can enforce it.
        --   A log that acknowledges an append before the record is held widely enough to survive a failure, or that lets a replica which never received it take over, withdraws a record it has already promised.
        --   Caught as the database connects this is an error message; caught later it is two nodes disagreeing about the term.
}

contract LeaderElection {
    -- The obligation this node fulfils toward whoever elects.
    -- Two operations, plus the ordering, fencing and atomicity properties that cannot be expressed as single-point-in-time state assertions.
    -- promote carries the new leader's fencing term, which the promotion stamps onto every replica record it goes on to write.
    promote: (processor: LogProcessor, term: Integer) -> LogProcessor
    demote: (processor: LogProcessor) -> LogProcessor

    @invariant DemoteSeesASettledRole
        -- A demote never observes a half-finished promotion: it acts on a node that is either following or leading, never mid-promotion.
        --   A promotion is unbounded (FollowerDrainsGapBeforeLead), so a demote arriving during one has to wait for it to settle rather than interleave with it.

    @invariant ExactlyOneConfirmedLeaderPerDatabase
        -- At most one leader's writes are ever CONFIRMED per database, enforced by the term fence on consume-back — Raft's ReadIndex, with no transactional append.
        -- Each leader stamps its replica writes with its own term.
        -- A leader confirms — and so acknowledges — a write only when it reads that write back at its OWN term; reading back a HIGHER term means a newer leader has superseded it, so it is demoted without confirming its outstanding writes.
        -- Two nodes may therefore briefly both believe themselves leader and both append, but only the newer term's writes are ever confirmed, and the older leader's are discarded.

    @invariant StandingDownLeavesTheDatabaseReadable
        -- A node that stands down for a higher term leaves its database queryable on that node.
        --   The end of a term reaches everything it was driving, the external source included, each of which reports a role that has changed rather than a database that has failed.

    @invariant FollowerIsSoleReplicaConsumer
        -- A follower is the sole replica-log consumer for its node; the leader consumes the source log and writes the replica log.

    @invariant FollowerDrainsGapBeforeLead
        -- A promotion must await the follower reaching the replay target BEFORE stopping it.
        --   Because the follower is the sole replica-log consumer and the leader consumes the source log instead, any replica records between the follower's position and the replay target would be silently skipped were the node to take the role without draining them first.
        --   That drain is the promotion's only unbounded step.

    @invariant RoleIsAlwaysBackedByALiveTerm
        -- The role is ALWAYS backed by a LIVE term — a follower whose replica consumption is running, or a live leader — never one that has been stopped.
        --   Stronger than RoleHasItsTerm, which asserts only that the term is present.
        --   A promotion stops its follower before it publishes its leader, so a promotion that fails in between has to re-open a live follower (RecoverFollowerOnFailedPromotion); otherwise the next promotion's catch-up would wait forever on a follower that can no longer advance.

    @invariant APendingBlockOutlivesTheRoleHoldingIt
        -- A block produced and not adopted MUST reach the role that replaces the one holding it, in either direction.
        --   The adopt is what moves this node's catalog past the block, so that a confirmation of it does not read as stale.
        --   A role that holds no block to match a confirmation against stops the node's replica consumption, and the database with it.
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity LogProcessor {
    -- One database's role on one node. Starts Following.
    database: Database

    -- Reading the replica log belongs to the node rather than to either term: one read feeds whichever role is live, a follower building state and a leader confirming its own writes alike.
    -- The position that read has reached is likewise the node's, so a role change continues from it rather than restarting — which is why it is held here and not on a term.
    replica_pos: MessageId

    -- The role.
    --   following  -- holds a live follower term.
    --   leading    -- holds a live leader term.
    state: following | leading

    transitions state {
        following -> leading     -- a promotion that published its leader term
        leading -> following     -- a demote
        -- No terminal state: a node cycles following/leading indefinitely.
    }

    -- The live follower term, present while Following.
    -- A promotion reads its catch-up target and then stops it.
    follower_term: FollowerTerm when state = following

    -- The live leader term, present while Leading. Produced by a promotion.
    leader_term: LeaderTerm when state = leading

    -- Derived: this node is the leader for its database.
    is_leading: state = leading
}

------------------------------------------------------------
-- Rules: promotion
--
-- The steps are ordered, and the order is what each one buys:
--   the claim has to be appended before it can be caught up to;
--   the catch-up has to finish before the follower is stopped, or records are skipped;
--   the fence has to be asked while the follower is alive, so a refusal can still recover;
--   the dangling block has to be produced after the follower stops, or it is produced twice.
------------------------------------------------------------

rule PromoteToLeader {
    -- term is the new leader's fencing term (see LeaderTerm.term).
    -- It is stamped onto every replica record this term writes, the claim below included, and checked on consume-back.
    when: PromotionRequested(elector, processor, term)

    requires: processor.state = following
    requires: processor.follower_term != null

    ensures:
        -- 1. Claim the term: append a record stamped with it, to learn a known, consumer-deliverable replay target.
        -- The log's end position will not do, because it can include positions a consumer never delivers, and the follower has to be able to await this one.
        let target = TermClaimed(term: term)

        -- 2. Await the follower catching up to the replay target.
        -- The only step that needs the follower alive, and the only unbounded one — see FollowerDrainsGapBeforeLead.
        -- Fails where this node's replica consumption has stopped, the target already reached or not: a leader taking the role behind a stopped read would never read its own writes back.
        FollowerCaughtUp(follower_term: processor.follower_term, target: target)

        -- 3. Refuse the claim if the replica log has already moved past the term being claimed.
        -- Step 1's claim carries this term and step 2 read it back, so by here the claimed term is expected to BE the highest the follower has seen.
        -- A strictly higher one is therefore another leader's, every reader would discard what this leader wrote, and it must not take the role.
        -- In practice a higher term means the elector's counter regressed underneath us — a counter that dies with the process, or an election group whose state was reclaimed — which is what the operator-declared epoch exists to keep terms rising across.
        -- The refusal names that epoch, because raising it is the operator's remedy.
        -- Refusing costs liveness only, never safety, so it is sound to decide from whatever the follower happens to have read.
        ClaimUnfenced(follower_term: processor.follower_term, target: target)

        -- 4. Stop the follower.
        FollowerStopped(follower_term: processor.follower_term)

        -- 5. Ask again whether the claim still stands, before anything is built or appended.
        -- Step 3's answer goes stale: it is given while the follower is still live, and the read goes on raising the highest term seen until that follower stops — over every record it admits, the ones it hands the follower to hold included.
        -- A highest term above this one refuses the claim, as step 3 does, and takes the same failure path.
        ClaimStillUnfenced(follower_term: processor.follower_term, term: term)

        -- 6. Produce any dangling block.
        -- Where the follower was mid-block — an old leader died before uploading it, or a term on this node produced it and never read it back — the incoming leader uploads the block's files and appends its confirmation under its OWN term.
        -- Requires the follower stopped (step 4), so the block cannot be produced twice.
        -- The block stays in flight: this term adopts it, and applies the records held behind the boundary, on reading a confirmation of it back — which is after step 7, this node's replica read being what delivers it. db.allium owns the adopt.
        -- That confirmation is this term's own, or the outgoing leader's where that term got one away before it ended: both confirm the same block, and the adopt takes whichever arrives first.
        -- So the block is carried into the leader term below, and a term that ends before adopting it hands it on again (see APendingBlockOutlivesTheRoleHoldingIt).
        if processor.follower_term.mid_block:
            DanglingBlockProduced(follower_term: processor.follower_term)

        -- 7. Take the role, carrying the fencing term.
        -- Replica records reach the new term from this node's own read, continuing from where the follower left off.
        processor.leader_term = LeaderTerm.created(
            term: term,
            replay_target: target,
            mid_block: processor.follower_term.mid_block
        )
        processor.follower_term = null
        processor.state = leading

        -- Source-log delivery resumes at the last applied source position, which db.allium owns.
        SourceDeliveryResumed(processor: processor)
}

rule RecoverFollowerOnFailedPromotion {
    -- A promotion that fails at any step leaves the node following, with a LIVE follower.
    -- Steps 4 to 6 fail with the follower already stopped, which is the case this rule exists for: without re-opening one, the next promotion's catch-up would wait forever on a follower that can no longer advance (see RoleIsAlwaysBackedByALiveTerm).
    when: PromotionFailed(elector, processor)

    -- The promotion never reached step 7, so the role is still following.
    requires: processor.state = following

    ensures:
        -- It carries the dangling block forward, step 6's produce having run or not: either way the block is in flight and this node's catalog has not moved past it, so the re-opened follower is what closes it.
        -- The read position is untouched: it is the node's, and nothing about a failed promotion moves it.
        processor.follower_term = FollowerTerm.created(
            mid_block: processor.follower_term.mid_block
        )
        processor.state = following
}

------------------------------------------------------------
-- Rules: demote
------------------------------------------------------------

rule DemoteLeader {
    -- A genuine leadership revoke while the node stays up — NOT shutdown, where tearing the database down ends the term (see NoDemoteOnShutdown).
    when: DemoteRequested(elector, processor)

    requires: processor.state = leading

    ensures:
        -- Re-open a follower. The durable live index is untouched, and so is the read position: the read spans the role change, so the follower continues from where the term left off rather than from anything the term claimed.
        -- A block the term produced and did not adopt goes with it, so the follower closes it on a confirmation of that block that the fence admits.
        -- It is read once the term has ended, as step 6 reads the follower's: the term goes on applying records until then, and one of them may be that confirmation.
        processor.follower_term = FollowerTerm.created(
            mid_block: processor.leader_term.mid_block
        )
        processor.leader_term = null
        processor.state = following
}

rule DemoteWhileFollowing {
    -- A demote on a node that is already following is a no-op: no leader term to end.
    when: DemoteRequested(elector, processor)

    requires: processor.state = following

    ensures:
        processor.state = following
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RoleHasItsTerm {
    -- Whatever role the node holds, it holds the matching term.
    -- That the term is also LIVE is RoleIsAlwaysBackedByALiveTerm, which this cannot express.
    for processor in LogProcessors:
        (processor.state = leading implies processor.leader_term != null)
        and (processor.state = following implies processor.follower_term != null)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Elector {
    -- Whoever decides which node leads a database: a coordinator shared between nodes, or trivially the single node itself where the log is local.
    -- Modelled as the external actor that drives role changes. Identified by the database it is driving.
    identified_by: Database where name != ""
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RoleTransitions {
    -- The two operations the elector calls to drive a database's role on this node.
    facing elector: Elector

    context processor: LogProcessor

    exposes:
        processor.state
        processor.is_leading

    provides:
        PromotionRequested(elector, processor, term) when processor.state = following
        DemoteRequested(elector, processor)
        -- A promotion that did not reach its final step, driving the recovery path.
        PromotionFailed(elector, processor) when processor.state = following

    contracts:
        fulfils LeaderElection

    @guarantee OneConfirmedLeaderViaTermFence
        -- At most one leader's writes are ever confirmed per database, enforced by the term fence on consume-back rather than by this interface: each leader stamps its replica writes with its term and confirms a write only when it reads that write back at its own term.
        --   Which is why the log's own obligations are stated in this module at all: the fence is nothing but readers agreeing on which term the log has reached, so it holds exactly as far as DurableTotalOrder does and no further.
}

surface ElectorObligations {
    -- What the elector must honour toward this node. It provides no operations here; those are on RoleTransitions.
    facing elector: Elector

    context processor: LogProcessor

    exposes:
        processor.state

    @guarantee AtMostOnePromotionInFlight
        -- At most one promotion is in flight per database at a time.

    @guarantee NoPromotionWhileLeading
        -- A node is not promoted for a database it already leads.

    @guarantee NoDemoteOnShutdown
        -- Shutdown does NOT demote: tearing the database down ends whichever term is live, the promotion included, so a promotion in flight needs no separate cancellation.
        -- Demote is only for a genuine leadership revoke while the node stays up.

    @guarantee RevokeSettlesAPromotionFirst
        -- On a genuine revoke, the elector lets an in-flight promotion settle — completing or failing — before demoting, so the demote runs against a settled role (see DemoteSeesASettledRole).
        -- This is bounded: the only unbounded step is the catch-up, which the settle can abandon.

    @guarantee ASupersededPromotionTakesNoRole
        -- A promotion whose assignment has since been superseded does not take the role, whether or not it completed.
        -- This is separate from the term fence, which fences a superseded leader's writes on the replica log; one keeps a stale promotion from ever starting, the other keeps a stale leader's writes from being confirmed.
}
