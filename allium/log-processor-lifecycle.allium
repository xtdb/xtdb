-- allium: 3
-- log-processor-lifecycle.allium
--
-- Scope: the per-database leader-election lifecycle in XTDB's LogProcessor.
--   A node reading a database's replica log claims leadership in that same log, and leads until a higher term supersedes it.
-- Includes: the Following / Leading state machine; how a claim is made and adjudicated; the term fence that keeps at most one CONFIRMED leader per database; the obligations the replica log has to meet for any of it to hold.
-- Excludes: live-index internals (see live-index.allium), record processing, block lifecycle, the ExternalSource lifecycle.
--
-- Complementarity with live-index.allium:
--   live-index.allium owns "whichever LogProcessor variant owns the live index
--   drives it as a single-threaded writer", treating WHICH variant is in play as
--   a given. This spec fills that gap: how the role is selected and
--   swapped. Reference live-index where relevant; do not duplicate its internals.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Database {
    -- The database whose replica log this processor reads. Its lifecycle governs the role: tearing the database down tears the live term down.
    name: String
}

external entity FollowerTerm {
    -- A follower: applies replica-log records to build local queryable state. See: live-index.allium.
    mid_block: Boolean   -- true if an old leader ended before uploading its block
}

external entity LeaderTerm {
    -- A leader: reads the SOURCE log, resolves client txs, and writes the replica log by plain (non-transactional) append. See: live-index.allium (Leader variant).
    --
    -- is_live is false from the moment the term ends until the reader reconciles the role (ReopenFollowerOnTermEnded).
    --
    -- The source-log tail belongs to the term, so it starts and ends with it.
    --
    is_live: Boolean

    -- A block this term cut but has not uploaded.
    -- It outlives the term: the follower replacing the term is seeded with it, and finishes it.
    has_pending_block: Boolean

    -- term is the fencing term this leader writes under.
    -- Every replica record it writes is STAMPED with this term, and the fence is applied on CONSUME-BACK: reading back a record above this term means a newer leader has superseded us, and we stand down (see live-index.allium, applyRecord).
    -- The term stamp plus the consume-back check is the whole fence -- there is no producer and no write-time failure.
    term: Integer
}

external entity ReplicaLog {
    -- The database's replica log: the durable, totally-ordered sequence of records every node reads, and the only place leadership is settled.
    -- It carries obligations (DurableTotalOrder) and takes no part in deciding who leads -- the answer is a function of its contents, which every reader computes alike.

    -- Whether anything has been submitted to it, answerable without reading it.
    is_empty: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value MessageId {
    -- A replica-log message offset. Encoded here as a plain integer position.
    offset: Integer
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DurableTotalOrder {
    -- What the replica log must supply for a term to mean anything.
    --
    -- append returns the position the record now occupies; poll delivers the records above a position, and reports the position reached.
    append: (log: ReplicaLog, term: Integer) -> MessageId
    poll: (log: ReplicaLog, after: MessageId) -> MessageId

    @invariant AppendReturnsItsOwnPosition
        -- An accepted append tells its author which position the record now occupies.
        --   A claim is identified by nothing but its position, so an author that could not learn where its own record landed could not tell its claim from anyone else's.

    @invariant OneAcceptedAppendYieldsOneRecord
        -- An accepted append puts exactly one record in the log, a refused one puts none, and the author is told which happened.
        --   A claim that landed twice occupies two positions, only one of which its author is watching for; the other is a record that confers leadership on a node that will never notice.

    @invariant OneOrderSeenByEveryReader
        -- Every reader of a log sees the same records at the same positions.
        --   Leadership is a function of position, so two readers disagreeing about the order would disagree about who leads.

    @invariant DeliveryFollowsPositionOrder
        -- A reader is delivered records in position order, and reaching a position means having been delivered everything below it.
        --   Independent of OneOrderSeenByEveryReader, which fixes where each record sits rather than the order a reader meets them in.
        --   Because the fence is applied on consume-back, a leader silently handed a gap can miss the higher-term record that supersedes it and go on confirming writes every other reader discards.
        --   A read that would skip a position has to fail rather than proceed.

    @invariant EmptyPollMeansTheTipWasReached
        -- A poll returns empty only when the reader that issued it has reached the log's tip.
        --   This is the observation a claim is made on, and it is the reader's own: it had to ask.
        --   A log that reported empty on its own account -- a timer, a dropped subscription -- would let a node that has stopped reading claim over a leader it can no longer see, fence that leader, fail to confirm its own claim, and repeat.

    @invariant AcceptedRecordsAreNeverWithdrawn
        -- Once an append is accepted, its record is never removed, replaced or moved while it stays above the retention boundary.
        --   Ordinarily a durability property; here a safety one, because a term reaches another node only as a record.
        --   Withdrawing one after that node has read it lets the two disagree about which term the log has reached, which is the one thing the fence cannot survive.

    @invariant RetentionKeepsEverythingAboveTheBoundary
        -- Records at or above the persisted boundary's position are retained; reclaiming those below it is expected.
        --   A term is seeded from the boundary and monotonic from there, so this is both what lets a starting node catch up at all and what puts a floor under the fence.
        --   Reclaiming a record that still sits above the boundary would unmoor the highest term seen from the log it is meant to describe.

    @invariant DurabilityIsConfiguredNotHoped
        -- Expected of the operator: AcceptedRecordsAreNeverWithdrawn has to hold in the DEPLOYED configuration, and nothing in here can enforce it.
        --   Settings that let an accepted append be lost -- acknowledging before the record is held widely enough to survive a failure, or letting a replica that never received it take over -- withdraw a record the log has already promised.
        --   Where the log can report its own settings they are worth checking as the database connects: caught at startup this is an error message, caught later it is two nodes disagreeing about the term.
}

contract Election {
    -- How leadership is decided, given a replica log meeting DurableTotalOrder.
    --
    -- claim appends a no-op above the highest term the claimant has read; confers answers whether a record at a position took leadership.
    claim: (processor: LogProcessor) -> MessageId
    confers: (processor: LogProcessor, at: MessageId) -> Boolean

    @invariant PositionDecidesTheClaim
        -- A claim confers leadership exactly when nothing at or above its term precedes it in the log.
        --   The claim's position is the whole of the answer, so every node computes the same one from the same prefix and no exchange between nodes is needed.
        --   Two claims at the same term are settled by which of them the log put first.

    @invariant ClaimFollowsObservation
        -- A node claims only from something it has read: a poll of its own that came back empty, or the absence of any term in the state it started from.
        --   A claim fences the incumbent whether or not it wins, so a node that could claim without reading would supersede a leader it cannot see, fail to confirm its own claim, and supersede the next leader in turn.

    @invariant ClaimsRiseAboveWhatWasRead
        -- A claim carries a term strictly above the highest the claimant has read.
        --   A claim at or below it confers nothing, so this is what makes a claim capable of winning at all.

    @invariant ConcurrentClaimantsConverge
        -- Two nodes finding the log quiet at once settle on one leader in bounded time.
        --   Each poll's length is drawn afresh, so nodes that claimed together next claim at different moments.
        --   A losing claim is a record, so reading it back ends the loser's poll and redraws it.

    @invariant ExactlyOneConfirmedLeaderPerDatabase
        -- At most one leader's writes are ever CONFIRMED per database, enforced by the term fence on consume-back (Raft's ReadIndex).
        --   Each leader stamps its replica writes with its own term, and confirms -- and so acknowledges -- a write only when it reads that write back at its OWN term.
        --   Reading back a HIGHER term means a newer leader has superseded it, so it stands down without confirming its outstanding writes.
        --   Two nodes may therefore briefly both believe themselves leader and both append, but only the newer term's writes are ever confirmed, and a lower-term record read back is discarded.
        --   See live-index.allium, applyRecord.

    @invariant LiveLeadershipIsVisibleOnTheLog
        -- A leader writes to the replica log within a bounded interval of its last write, whether or not it has work.
        --   - With traffic: met by the writes it is making anyway.
        --   - Idle: a no-op stamped with its own term.
        --   Otherwise a quiet database and a leaderless one are the same log to a reader.

    @invariant StandingDownLeavesTheDatabaseReadable
        -- A node that stands down for a higher term leaves its database queryable on that node.
        --   The end of a term reaches everything it was driving, the external source included, each of which reports a role that has changed rather than a database that has failed.

    @invariant OneReplicaReaderPerPartition
        -- One reader per partition consumes the replica log, whichever role is live; the leader additionally reads the source log.
        --   So a role change continues from the position the reader has reached, and no replica record is skipped across one.
        --   The reader outlives every term it drives, a promotion that failed to start one included, so reading ends only with the database's membership.

    @invariant LiveTermBackingRole
        -- No record is ever applied through a term that has ended.
        --   Cutting over stops the follower before it publishes the leader, so a failure in between would otherwise leave the role holding a term that can no longer advance; the failure path re-opens a live follower (RecoverFollowerOnCutOverFailed), and the teardown and that recovery are atomic with respect to cancellation.
        --   A term that ends on its own leaves the role standing until the reader's next poll reconciles it (ReopenFollowerOnTermEnded). Through that window the node reports itself as no longer leading, and a record offered to the ended role is re-offered to the follower that replaces it.
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity LogProcessor {
    -- The per-database role state machine, and the reader that drives it. Starts Following.
    --
    -- The reader is the only writer of the role, so a role change needs no coordination with anything else on the node.
    database: Database

    -- The log this processor reads, claims in, and is fenced against.
    replica_log: ReplicaLog

    -- How far this node has read its replica log.
    -- Every record read advances it, applied or discarded, and it belongs to the partition rather than to either role -- so a role change continues from where the reader had got to.
    replica_pos: MessageId

    -- The role.
    --   following  -- holds a live follower term.
    --   leading    -- holds a live leader term.
    state: following | leading

    transitions state {
        following -> leading     -- a claim of ours was read back and conferred
        leading -> following     -- the leader term ended
        -- No terminal state: a processor cycles following/leading indefinitely.
    }

    -- The highest term read from the replica log.
    -- Scoped to the partition for its whole life rather than to a role: seeded once from the persisted block boundary, and monotonic from there.
    -- Held per role it would be reseeded at every role change, forgetting every term written since the last block flush -- so the same term could be admitted twice, once either side of a role change.
    highest_seen: Integer

    -- Whether this node is permitted to lead at all. Fixed for its life: a read-only database is reconfigured by replacing it.
    may_lead: Boolean

    -- The live follower term, present while Following.
    follower_term: FollowerTerm when state = following

    -- The position of a claim of ours that is in flight, present while Following and while one is outstanding.
    claim_pos: MessageId when state = following

    -- The live leader term, present while Leading.
    leader_term: LeaderTerm when state = leading

    -- Derived: this node is the leader for its database, and holds a live term to lead with.
    is_leading: state = leading and leader_term.is_live
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

------------------------------------------------------------
-- Rule: claim leadership
--
-- Two observations admit a claim, and both are the node's own.
------------------------------------------------------------

rule ClaimOnEmptyPoll {
    -- A poll of this node's own returned nothing, so the log is at its tip and whoever last led it has stopped writing.
    when: PollReturnedEmpty(processor)

    requires: processor.state = following
    requires: processor.may_lead
    requires: processor.claim_pos = null

    ensures:
        processor.claim_pos = NoOpAppended(term: processor.highest_seen + 1)
}

rule ClaimWhenNoTermHasLed {
    -- No block has been written and the log is empty, so nobody has ever led this database and there is nothing to read that could confer anything.
    -- Nothing can precede a claim at the lowest term, so it confers at once and the node leads without waiting out an election.
    -- The empty log is required as well as the seeded fence: a claim taken before reading is a durable append ahead of every record still to be applied, so against a log with content it delays catch-up to make a claim those records already beat.
    when: ProcessorStarted(processor)

    requires: processor.state = following
    requires: processor.may_lead
    requires: processor.highest_seen = 0
    requires: processor.replica_log.is_empty

    ensures:
        processor.claim_pos = NoOpAppended(term: 1)
}

------------------------------------------------------------
-- Rule: adjudicate a claim
--
-- A claim is read back like any other record, so by the time it is judged it has already been applied.
------------------------------------------------------------

rule ClaimConferredLeadership {
    when: RecordRead(processor, pos, term)

    requires: processor.state = following
    requires: pos = processor.claim_pos
    requires: term > processor.highest_seen

    ensures:
        processor.highest_seen = term

        -- Stop the follower, and finish any block an earlier leader left dangling.
        -- If the follower was mid-block, the incoming leader uploads the block and replays its buffered records, with leader-upload semantics.
        -- Requires the follower stopped so it cannot double-process.
        FollowerStopped(follower_term: processor.follower_term)

        if processor.follower_term.mid_block:
            DanglingBlockFinished(follower_term: processor.follower_term)

        processor.leader_term = LeaderTerm.created(term: term)
        processor.follower_term = null
        processor.claim_pos = null
        processor.state = leading
}

rule ClaimConferredNothing {
    -- A claim the log put behind a term at or above it. The claimant keeps following, and is free to claim again from what it has now read.
    when: RecordRead(processor, pos, term)

    requires: processor.state = following
    requires: pos = processor.claim_pos
    requires: term <= processor.highest_seen

    ensures:
        processor.claim_pos = null
        processor.state = following
}

rule DiscardRecordBelowTheFence {
    -- A record written by a leader the log has moved past.
    --   Application is suppressed; consumption is not, so a reader catching up never stalls on one.
    --   The unset term is exempt and applies everywhere: it is the bottom of the ordering, so fencing it would discard a not-yet-upgraded leader's writes.
    when: RecordRead(processor, pos, term)

    requires: term > 0
    requires: term < processor.highest_seen

    ensures:
        processor.replica_pos = pos
}

------------------------------------------------------------
-- Rule: stand down
--
-- A leader term ends itself -- superseded, or failed -- so the reader re-opens a follower when it finds the term over.
------------------------------------------------------------

rule ReopenFollowerOnTermEnded {
    when: LeaderTermEnded(processor)

    requires: processor.state = leading

    ensures:
        -- replica_pos and any pending block carry across, so the follower resumes where the term stopped and finishes what it cut.
        -- The durable live index is untouched (see live-index.allium).
        processor.follower_term = FollowerTerm.created(mid_block: processor.leader_term.has_pending_block)
        processor.leader_term = null
        processor.state = following
}

rule RecoverFollowerOnCutOverFailed {
    -- The cut-over stops the follower before it publishes the leader, so a failure in between leaves the role holding a term that can no longer advance.
    -- Re-opening a live follower is what keeps LiveTermBackingRole true through that window.
    when: CutOverFailed(processor)

    requires: processor.state = following

    ensures:
        -- Seeded from the follower the cut-over stopped, so its pending block is still finished.
        processor.follower_term = FollowerTerm.created(mid_block: processor.follower_term.mid_block)
        processor.claim_pos = null
        processor.state = following
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RoleHasItsTerm {
    -- Whatever role the processor holds, it holds the matching term.
    for processor in LogProcessors:
        (processor.state = leading implies processor.leader_term != null)
        and (processor.state = following implies processor.follower_term != null)
}

invariant OnlyAnEligibleNodeHoldsAClaim {
    -- A node that may not lead never has a claim outstanding, and so never leads.
    for processor in LogProcessors:
        (not processor.may_lead) implies (processor.claim_pos = null and processor.state = following)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Node {
    -- The node this processor runs on. It opens the processor and runs its replica-log reader, which is where every event below comes from.
    -- Identified by the database it is reading.
    identified_by: Database where name != ""
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ReplicaLogReading {
    -- The reader's boundary: what a node's own reading of the replica log tells its role.
    -- Every event here is the node's own observation, which is what ClaimFollowsObservation turns on.
    facing node: Node

    context processor: LogProcessor

    exposes:
        processor.state
        processor.highest_seen
        processor.is_leading

    provides:
        -- The processor opened, before it has read anything.
        ProcessorStarted(node, processor) when processor.state = following

        -- A poll of this node's own came back empty, so it has reached the log's tip.
        PollReturnedEmpty(node, processor) when processor.state = following

        -- A record was delivered at a position, carrying a term.
        RecordRead(node, processor, pos, term)

        -- The leader term ended -- superseded by a higher term, or failed.
        LeaderTermEnded(node, processor) when processor.state = leading

        -- The cut-over stopped the follower and then failed before publishing the leader.
        CutOverFailed(node, processor) when processor.state = following

    contracts:
        fulfils Election

    @guarantee LeadershipMovesWithoutCoordination
        -- Leadership moves between nodes with nothing exchanged between them, and nothing outside the database's own replica log consulted.
        --   So two deployments sharing a log cluster are isolated by their topic names, and a database's leadership changes disturb no other database.

    @guarantee LeadershipPlacementIsUnbalanced
        -- Which node leads which database is whichever claimed first, and leadership moves only when a term ends.
        --   One node may lead several databases while another leads none, and the distribution does not even out on its own.

    @guarantee OneConfirmedLeaderViaTermFence
        -- At most one leader's writes are ever confirmed per database, enforced by the term fence on consume-back rather than by anything at this boundary.
        --   Which is why the log's own obligations are stated in this module at all: the fence is nothing but readers agreeing on which term the log has reached, so it holds exactly as far as DurableTotalOrder does and no further.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- OQ1: a leader that can append but not read goes on asserting, so it reads as
--   healthy to every other node while its own ingestion is stopped -- and no
--   follower's poll ever comes back empty, so nobody supersedes it. The shape of
--   the answer is that a term times out on reading back its own writes and ends
--   itself, suppressed while it knows it is busy uploading a block.
